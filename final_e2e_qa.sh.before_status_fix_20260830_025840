fail=0

check() {
    NAME="$1"
    URL="$2"
    METHOD="${3:-GET}"
    DATA="${4:-}"

    echo
    echo "===== $NAME ====="

    if [ "$METHOD" = "GET" ]; then
        RESP=$(curl -s -w "\n__HTTP__%{http_code}" "$URL")
    else
        RESP=$(curl -s -X "$METHOD" "$URL" \
            -H "Content-Type: application/json" \
            -d "$DATA" \
            -w "\n__HTTP__%{http_code}")
    fi

    echo "$RESP"

    HTTP=$(echo "$RESP" | sed -n 's/__HTTP__//p' | tail -1)

    if [ "$HTTP" -ge 200 ] && [ "$HTTP" -lt 300 ]; then
        echo "PASS: $HTTP"
    else
        echo "FAIL: $HTTP"
        fail=$((fail+1))
    fi
}

