<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seller Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #1f2937;
        }

        .header {
            background: #111827;
            color: white;
            padding: 18px 20px;
        }

        .header h1 {
            margin: 0;
            font-size: 22px;
        }

        .header p {
            margin: 5px 0 0;
            color: #cbd5e1;
            font-size: 13px;
        }

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 20px;
        }

        .seller-card {
            background: white;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 20px;
            box-shadow: 0 3px 12px rgba(0,0,0,.06);
        }

        .seller-card h2 {
            margin: 0 0 8px;
            font-size: 20px;
        }

        .seller-meta {
            color: #64748b;
            font-size: 14px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 20px;
        }

        .stat {
            background: white;
            border-radius: 14px;
            padding: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,.06);
        }

        .stat-title {
            color: #64748b;
            font-size: 13px;
        }

        .stat-value {
            font-size: 26px;
            font-weight: bold;
            margin-top: 7px;
        }

        .section {
            background: white;
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 20px;
            box-shadow: 0 3px 12px rgba(0,0,0,.06);
            overflow-x: auto;
        }

        .section h2 {
            margin-top: 0;
            font-size: 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 650px;
        }

        th,
        td {
            padding: 11px 10px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
            font-size: 13px;
        }

        th {
            background: #f8fafc;
            color: #475569;
        }

        .badge {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: bold;
        }

        .active {
            background: #dcfce7;
            color: #166534;
        }

        .inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        .warning {
            background: #fef3c7;
            color: #92400e;
        }

        .loading {
            text-align: center;
            padding: 30px;
            color: #64748b;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: none;
        }

        .refresh {
            float: right;
            border: 0;
            background: #2563eb;
            color: white;
            padding: 9px 14px;
            border-radius: 8px;
            cursor: pointer;
        }

        .refresh:hover {
            opacity: .9;
        }

        @media (max-width: 900px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 550px) {
            .container {
                padding: 12px;
            }

            .grid {
                grid-template-columns: 1fr 1fr;
                gap: 9px;
            }

            .stat {
                padding: 14px;
            }

            .stat-value {
                font-size: 21px;
            }
        }
    </style>
</head>

<body>

<div class="header">
    <h1>Seller Dashboard</h1>
    <p>Products • Orders • Stock • Sales Overview</p>
</div>

<div class="container">

    <div id="errorBox" class="error"></div>

    <div class="seller-card">
        <button class="refresh" onclick="loadDashboard()">Refresh</button>
        <h2 id="sellerName">Loading seller...</h2>
        <div class="seller-meta">
            Seller ID:
            <strong id="sellerId">-</strong>
            &nbsp; | &nbsp;
            Phone:
            <strong id="sellerPhone">-</strong>
            &nbsp; | &nbsp;
            Status:
            <strong id="sellerStatus">-</strong>
        </div>
    </div>

    <div id="loading" class="loading">
        Loading dashboard...
    </div>

    <div id="dashboard" style="display:none;">

        <div class="grid">

            <div class="stat">
                <div class="stat-title">Total Products</div>
                <div class="stat-value" id="totalProducts">0</div>
            </div>

            <div class="stat">
                <div class="stat-title">Active Products</div>
                <div class="stat-value" id="activeProducts">0</div>
            </div>

            <div class="stat">
                <div class="stat-title">Total Stock</div>
                <div class="stat-value" id="totalStock">0</div>
            </div>

            <div class="stat">
                <div class="stat-title">Low Stock</div>
                <div class="stat-value" id="lowStock">0</div>
            </div>

            <div class="stat">
                <div class="stat-title">Total Orders</div>
                <div class="stat-value" id="totalOrders">0</div>
            </div>

            <div class="stat">
                <div class="stat-title">Placed</div>
                <div class="stat-value" id="placedOrders">0</div>
            </div>

            <div class="stat">
                <div class="stat-title">Delivered</div>
                <div class="stat-value" id="deliveredOrders">0</div>
            </div>

            <div class="stat">
                <div class="stat-title">Order Value</div>
                <div class="stat-value" id="orderValue">₹0</div>
            </div>

        </div>

        <div class="section">
            <h2>Recent Orders</h2>

            <table>
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody id="ordersBody"></tbody>
            </table>

            <div id="ordersEmpty" class="loading" style="display:none;">
                No orders found.
            </div>
        </div>

        <div class="section">
            <h2>Low Stock Products</h2>

            <table>
                <thead>
                    <tr>
                        <th>Product ID</th>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody id="productsBody"></tbody>
            </table>

            <div id="productsEmpty" class="loading" style="display:none;">
                No low-stock products.
            </div>
        </div>

    </div>
</div>

<script>
    const SELLER_ID = "{{ seller_id }}";

    function money(value) {
        return "₹" + Number(value || 0).toFixed(2);
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function showError(message) {
        const box = document.getElementById("errorBox");
        box.textContent = message;
        box.style.display = "block";
    }

    function clearError() {
        const box = document.getElementById("errorBox");
        box.style.display = "none";
        box.textContent = "";
    }

    async function loadDashboard() {
        clearError();

        document.getElementById("loading").style.display = "block";
        document.getElementById("dashboard").style.display = "none";

        try {
            const response = await fetch(
                "/api/sellers/" +
                encodeURIComponent(SELLER_ID) +
                "/dashboard"
            );

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(
                    data.message || "Dashboard request failed"
                );
            }

            renderDashboard(data);

        } catch (error) {
            showError(error.message);
        } finally {
            document.getElementById("loading").style.display = "none";
        }
    }

    function renderDashboard(data) {
        const seller = data.seller || {};
        const products = (data.summary || {}).products || {};
        const orders = (data.summary || {}).orders || {};

        document.getElementById("sellerName").textContent =
            seller.name || "Seller";

        document.getElementById("sellerId").textContent =
            seller.seller_id || SELLER_ID;

        document.getElementById("sellerPhone").textContent =
            seller.phone || "-";

        document.getElementById("sellerStatus").textContent =
            seller.status || "-";

        document.getElementById("totalProducts").textContent =
            products.total || 0;

        document.getElementById("activeProducts").textContent =
            products.active || 0;

        document.getElementById("totalStock").textContent =
            products.total_stock || 0;

        document.getElementById("lowStock").textContent =
            (data.low_stock_products || []).length;

        document.getElementById("totalOrders").textContent =
            orders.total || 0;

        document.getElementById("placedOrders").textContent =
            orders.placed || 0;

        document.getElementById("deliveredOrders").textContent =
            orders.delivered || 0;

        document.getElementById("orderValue").textContent =
            money(orders.total_order_value);

        renderOrders(data.recent_orders || []);
        renderProducts(data.low_stock_products || []);

        document.getElementById("dashboard").style.display = "block";
    }

    function renderOrders(orders) {
        const body = document.getElementById("ordersBody");
        const empty = document.getElementById("ordersEmpty");

        body.innerHTML = "";

        if (!orders.length) {
            empty.style.display = "block";
            return;
        }

        empty.style.display = "none";

        orders.forEach(order => {
            const status = escapeHtml(order.order_status || "-");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>${escapeHtml(order.order_id)}</td>
                <td>${escapeHtml(order.customer_name)}</td>
                <td>${escapeHtml(order.payment_type)}</td>
                <td>
                    <span class="badge active">
                        ${status}
                    </span>
                </td>
                <td>${money(order.total_amount)}</td>
                <td>${escapeHtml(order.created_at || "-")}</td>
            `;

            body.appendChild(row);
        });
    }

    function renderProducts(products) {
        const body = document.getElementById("productsBody");
        const empty = document.getElementById("productsEmpty");

        body.innerHTML = "";

        if (!products.length) {
            empty.style.display = "block";
            return;
        }

        empty.style.display = "none";

        products.forEach(product => {
            const row = document.createElement("tr");

            row.innerHTML = `
                <td>${escapeHtml(product.product_id)}</td>
                <td>${escapeHtml(product.name)}</td>
                <td>${escapeHtml(product.sku || "-")}</td>
                <td>${money(product.price)}</td>
                <td>
                    <span class="badge warning">
                        ${escapeHtml(product.stock)}
                    </span>
                </td>
                <td>
                    <span class="badge active">
                        ${escapeHtml(product.status)}
                    </span>
                </td>
            `;

            body.appendChild(row);
        });
    }

    loadDashboard();
</script>

</body>
</html>

