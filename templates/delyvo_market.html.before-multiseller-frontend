<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#111827">
<title>Delyvo Logistics - Market</title>

<style>
*{box-sizing:border-box}
body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f5f6f8;
    color:#111827;
}
header{
    position:sticky;
    top:0;
    z-index:10;
    background:#111827;
    color:white;
    padding:14px;
}
.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}
.logo{
    font-size:23px;
    font-weight:800;
}
.cart{
    background:white;
    color:#111827;
    border:0;
    border-radius:20px;
    padding:8px 13px;
    font-weight:bold;
}
.search{
    margin-top:12px;
    width:100%;
    padding:13px;
    border:0;
    border-radius:10px;
    font-size:15px;
}
.container{
    padding:15px;
    max-width:700px;
    margin:auto;
}
.banner{
    background:linear-gradient(135deg,#111827,#374151);
    color:white;
    border-radius:16px;
    padding:22px;
    margin-bottom:18px;
}
.banner h1{margin:0 0 7px}
.banner p{margin:0;color:#d1d5db}
.section-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:18px 0 10px;
}
.categories{
    display:flex;
    gap:10px;
    overflow-x:auto;
}
.category{
    min-width:85px;
    padding:12px 10px;
    border:0;
    border-radius:12px;
    background:white;
    box-shadow:0 2px 8px #00000010;
}
.products{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}
.card{
    background:white;
    border-radius:14px;
    overflow:hidden;
    box-shadow:0 2px 10px #00000010;
}
.pic{
    height:145px;
    background:#e5e7eb;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:45px;
}
.info{padding:11px}
.name{
    font-weight:bold;
    min-height:38px;
}
.price{
    font-size:19px;
    font-weight:800;
    margin:7px 0;
}
.stock{
    font-size:12px;
    color:#6b7280;
}
.add{
    width:100%;
    border:0;
    border-radius:9px;
    padding:10px;
    margin-top:8px;
    background:#111827;
    color:white;
    font-weight:bold;
}
.empty{
    background:white;
    padding:25px;
    border-radius:14px;
    text-align:center;
}
.modal{
    display:none;
    position:fixed;
    inset:0;
    background:#0008;
    z-index:20;
    align-items:flex-end;
}
.sheet{
    background:white;
    width:100%;
    max-height:90vh;
    overflow:auto;
    border-radius:20px 20px 0 0;
    padding:18px;
}
.close{
    float:right;
    border:0;
    background:#eee;
    border-radius:50%;
    width:35px;
    height:35px;
}
.item{
    display:flex;
    justify-content:space-between;
    padding:12px 0;
    border-bottom:1px solid #eee;
}
.qty button{
    border:1px solid #ddd;
    background:white;
    padding:4px 9px;
}
input,textarea,select{
    width:100%;
    padding:12px;
    margin:6px 0;
    border:1px solid #ddd;
    border-radius:9px;
}
.primary{
    width:100%;
    padding:13px;
    background:#111827;
    color:white;
    border:0;
    border-radius:10px;
    font-weight:bold;
    margin-top:10px;
}
.nav{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:white;
    border-top:1px solid #ddd;
    display:flex;
    justify-content:space-around;
    padding:10px;
    z-index:15;
}
.nav button{
    border:0;
    background:none;
    font-size:12px;
}
main{padding-bottom:70px}
</style>
</head>

<body>

<header>
    <div class="top">
        <div class="logo">Delyvo Market</div>
        <button class="cart" onclick="openCart()">🛒 Cart <span id="cartCount">0</span></button>
    </div>
    <input id="search" class="search"
           placeholder="Search products..."
           oninput="filterProducts()">
</header>

<main>
<div class="container">

    <div class="banner">
        <h1>Shop on Delyvo</h1>
        <p>Products from Delyvo sellers, delivered to your door.</p>
    </div>

    <div class="section-title">
        <h3>Categories</h3>
    </div>

    <div class="categories">
        <button class="category" onclick="setCategory('all')">🛍️ All</button>
        <button class="category" onclick="setCategory('fashion')">👕 Fashion</button>
        <button class="category" onclick="setCategory('electronics')">📱 Electronics</button>
        <button class="category" onclick="setCategory('home')">🏠 Home</button>
        <button class="category" onclick="setCategory('beauty')">💄 Beauty</button>
    </div>

    <div class="section-title">
        <h3>Products</h3>
        <span id="productCount"></span>
    </div>

    <div id="products" class="products">
        <div class="empty">Loading products...</div>
    </div>

</div>
</main>

<div class="nav">
    <button onclick="window.scrollTo({top:0,behavior:'smooth'})">🏠<br>Home</button>
    <button onclick="openCart()">🛒<br>Cart</button>
    <button onclick="openOrders()">📦<br>Orders</button>
    <button onclick="openProfile()">👤<br>Account</button>
</div>

<!-- CART -->
<div id="cartModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('cartModal')">×</button>
<h2>Your Cart</h2>
<div id="cartItems"></div>
<div id="cartTotal"></div>
<button class="primary" onclick="openCheckout()">Proceed to Checkout</button>
</div>
</div>

<!-- CHECKOUT -->
<div id="checkoutModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('checkoutModal')">×</button>
<h2>Checkout</h2>

<input id="customerName" placeholder="Your name">
<input id="customerPhone" placeholder="Phone number">
<textarea id="address" placeholder="Delivery address"></textarea>

<select id="paymentType">
<option value="COD">Cash on Delivery</option>
<option value="ONLINE">Online Payment</option>
</select>

<div id="checkoutTotal"></div>

<button class="primary" onclick="placeOrder()">Place Order</button>
</div>
</div>

<!-- ORDERS -->
<div id="ordersModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('ordersModal')">×</button>
<h2>My Orders</h2>
<div id="orders"></div>
</div>
</div>

<!-- PROFILE -->
<div id="profileModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('profileModal')">×</button>
<h2>My Account</h2>
<p>👤 Delyvo Market Customer</p>
<p>Orders can be viewed from the Orders section.</p>
</div>
</div>

<script>
const SELLER_ID = "SEL-90C7AA9E";

let products = [];
let cart = [];
let category = "all";

function money(x){
    return "₹" + Number(x || 0).toFixed(0);
}

async function loadProducts(){
    const box = document.getElementById("products");

    try{
        const r = await fetch(`/api/sellers/${SELLER_ID}/products`);
        const data = await r.json();

        if(!r.ok || data.success === false){
            throw new Error("Product API failed");
        }

        products = (data.products || []).filter(p =>
            p.status === "ACTIVE" && Number(p.stock) > 0
        );

        renderProducts(products);
    }catch(e){
        box.innerHTML =
            `<div class="empty">
                Products load nahi ho paaye.<br><br>
                Backend connection check karein.
             </div>`;
    }
}

function renderProducts(list){
    const box = document.getElementById("products");

    document.getElementById("productCount").textContent =
        `${list.length} products`;

    if(!list.length){
        box.innerHTML = `<div class="empty">No products found.</div>`;
        return;
    }

    box.innerHTML = list.map(p => `
        <div class="card">
            <div class="pic">📦</div>
            <div class="info">
                <div class="name">${escapeHtml(p.name)}</div>
                <div class="price">${money(p.price)}</div>
                <div class="stock">${p.stock} available</div>
                <button class="add" onclick="addToCart('${p.product_id}')">
                    Add to Cart
                </button>
            </div>
        </div>
    `).join("");
}

function escapeHtml(s){
    return String(s || "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;");
}

function setCategory(c){
    category = c;
    filterProducts();
}

function filterProducts(){
    const q = document.getElementById("search").value.toLowerCase();

    let list = products.filter(p =>
        String(p.name).toLowerCase().includes(q) ||
        String(p.description || "").toLowerCase().includes(q)
    );

    renderProducts(list);
}

function addToCart(id){
    const p = products.find(x => x.product_id === id);
    if(!p) return;

    const existing = cart.find(x => x.product_id === id);

    if(existing){
        if(existing.quantity < Number(p.stock)){
            existing.quantity++;
        }else{
            alert("Stock limit reached");
        }
    }else{
        cart.push({
            product_id:p.product_id,
            name:p.name,
            price:Number(p.price),
            stock:Number(p.stock),
            quantity:1
        });
    }

    saveCart();
    updateCartCount();
}

function saveCart(){
    localStorage.setItem("delyvo_cart",JSON.stringify(cart));
}

function loadCart(){
    try{
        cart = JSON.parse(
            localStorage.getItem("delyvo_cart") || "[]"
        );
    }catch{
        cart=[];
    }
    updateCartCount();
}

function updateCartCount(){
    document.getElementById("cartCount").textContent =
        cart.reduce((a,b)=>a+b.quantity,0);
}

function openCart(){
    renderCart();
    document.getElementById("cartModal").style.display="flex";
}

function renderCart(){
    const box = document.getElementById("cartItems");

    if(!cart.length){
        box.innerHTML = `<div class="empty">Cart is empty.</div>`;
        document.getElementById("cartTotal").innerHTML="";
        return;
    }

    box.innerHTML = cart.map((x,i)=>`
        <div class="item">
            <div>
                <b>${escapeHtml(x.name)}</b><br>
                ${money(x.price)} × ${x.quantity}
            </div>
            <div class="qty">
                <button onclick="changeQty(${i},-1)">−</button>
                ${x.quantity}
                <button onclick="changeQty(${i},1)">+</button>
            </div>
        </div>
    `).join("");

    const subtotal = cart.reduce(
        (a,b)=>a+(b.price*b.quantity),0
    );

    document.getElementById("cartTotal").innerHTML =
        `<h3>Subtotal: ${money(subtotal)}</h3>`;
}

function changeQty(i,d){
    cart[i].quantity += d;

    if(cart[i].quantity <= 0){
        cart.splice(i,1);
    }else if(cart[i].quantity > cart[i].stock){
        cart[i].quantity = cart[i].stock;
        alert("Stock limit reached");
    }

    saveCart();
    updateCartCount();
    renderCart();
}

function openCheckout(){
    if(!cart.length){
        alert("Cart is empty");
        return;
    }

    closeModal("cartModal");

    const subtotal = cart.reduce(
        (a,b)=>a+(b.price*b.quantity),0
    );

    document.getElementById("checkoutTotal").innerHTML =
        `<h3>Total: ${money(subtotal + 50)}</h3>
         <small>Delivery fee: ₹50</small>`;

    document.getElementById("checkoutModal").style.display="flex";
}

async function placeOrder(){
    if(!cart.length){
        alert("Cart is empty");
        return;
    }

    const customer_name =
        document.getElementById("customerName").value.trim();

    const customer_phone =
        document.getElementById("customerPhone").value.trim();

    const delivery_address =
        document.getElementById("address").value.trim();

    const payment_type =
        document.getElementById("paymentType").value;

    if(!customer_name || !customer_phone || !delivery_address){
        alert("Please fill all delivery details");
        return;
    }

    const items = cart.map(x=>({
        product_id:x.product_id,
        quantity:x.quantity
    }));

    try{
        const r = await fetch(
            `/api/sellers/${SELLER_ID}/orders`,
            {
                method:"POST",
                headers:{
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    customer_name,
                    customer_phone,
                    delivery_address,
                    payment_type,
                    delivery_fee:50,
                    items
                })
            }
        );

        const data = await r.json();

        if(!r.ok || data.success === false){
            alert(data.message || "Order failed");
            return;
        }

        const order =
            data.order || {};

        const orderId =
            data.order_id || order.order_id || "ORDER";

        localStorage.setItem(
            "delyvo_last_order",
            orderId
        );

        cart=[];
        saveCart();
        updateCartCount();

        closeModal("checkoutModal");

        alert(
            "Order placed successfully!\\n\\nOrder ID: " +
            orderId
        );

        loadProducts();
    }catch(e){
        alert("Server connection error");
    }
}

async function openOrders(){
    document.getElementById("ordersModal").style.display="flex";

    const box = document.getElementById("orders");
    box.innerHTML = "Loading orders...";

    try{
        const r = await fetch(
            `/api/sellers/${SELLER_ID}/orders`
        );

        const data = await r.json();
        const list = data.orders || [];

        if(!list.length){
            box.innerHTML =
                `<div class="empty">No orders yet.</div>`;
            return;
        }

        box.innerHTML = list.map(o=>`
            <div class="item">
                <div>
                    <b>${escapeHtml(o.order_id)}</b><br>
                    ${escapeHtml(o.order_status || "PLACED")}<br>
                    ${money(o.total_amount)}
                </div>
                <div>📦</div>
            </div>
        `).join("");
    }catch(e){
        box.innerHTML =
            `<div class="empty">Orders load nahi ho paaye.</div>`;
    }
}

function openProfile(){
    document.getElementById("profileModal").style.display="flex";
}

function closeModal(id){
    document.getElementById(id).style.display="none";
}

loadCart();
loadProducts();
</script>

</body>
</html>
