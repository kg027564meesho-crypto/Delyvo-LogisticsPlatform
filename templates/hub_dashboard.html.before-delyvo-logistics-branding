<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,initial-scale=1.0">

<title>Delyvo Hub</title>

<style>

*{
box-sizing:border-box;
}

body{
margin:0;
font-family:Arial,sans-serif;
background:#f4f6f8;
color:#111827;
}

header{
background:#111827;
color:white;
padding:18px;
position:sticky;
top:0;
z-index:10;
}

.logo{
font-size:24px;
font-weight:800;
}

.container{
max-width:900px;
margin:auto;
padding:16px;
}

.hero{
background:#1f2937;
color:white;
padding:22px;
border-radius:18px;
margin-bottom:18px;
}

.hero h1{
margin:0 0 8px;
}

.hero p{
margin:0;
color:#d1d5db;
}

.card{
background:white;
border-radius:15px;
padding:17px;
margin-bottom:15px;
box-shadow:0 2px 10px #00000012;
}

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
}

.stat{
background:white;
border-radius:15px;
padding:17px;
box-shadow:0 2px 10px #00000012;
}

.label{
color:#6b7280;
font-size:13px;
}

.number{
font-size:27px;
font-weight:800;
margin-top:6px;
}

input{
width:100%;
padding:12px;
border:1px solid #ddd;
border-radius:9px;
margin:6px 0;
}

button{
border:0;
border-radius:9px;
padding:11px 15px;
background:#111827;
color:white;
font-weight:bold;
cursor:pointer;
margin-top:7px;
}

.full{
width:100%;
}

.result{
margin-top:12px;
background:#f3f4f6;
border-radius:10px;
padding:12px;
overflow:auto;
font-size:13px;
}

.success{
color:#15803d;
font-weight:bold;
}

.error{
color:#b91c1c;
font-weight:bold;
}

@media(max-width:700px){

.grid{
grid-template-columns:repeat(2,1fr);
}

}

</style>

</head>

<body>

<header>

<div class="logo">
Delyvo Hub
</div>

</header>

<div class="container">

<div class="hero">

<h1>Hub Control Center</h1>

<p>
Manage hub operations, shipments and delivery partners.
</p>

</div>


<div class="card">

<h3>Select Hub</h3>

<input
id="hubCode"
placeholder="Hub Code e.g. HUB-001">

<button
class="full"
onclick="loadHub()">

Load Hub

</button>

<div id="result" class="result">
Enter Hub Code.
</div>

</div>


<div id="stats"
class="grid"
style="display:none">

<div class="stat">

<div class="label">
Shipments
</div>

<div id="shipmentCount"
class="number">
0
</div>

</div>


<div class="stat">

<div class="label">
Partners
</div>

<div id="partnerCount"
class="number">
0
</div>

</div>


<div class="stat">

<div class="label">
Hub Status
</div>

<div id="hubStatus"
class="number">
-
</div>

</div>

</div>


<div class="card">

<h3>Hub Information</h3>

<div id="hubInfo">
No hub loaded.
</div>

</div>


<div class="card">

<h3>Hub Shipments</h3>

<button
onclick="loadShipments()">

Refresh Shipments

</button>

<div id="shipments"
class="result">

No shipments loaded.

</div>

</div>


<div class="card">

<h3>Delivery Partners</h3>

<button
onclick="loadPartners()">

Refresh Partners

</button>

<div id="partners"
class="result">

No partners loaded.

</div>

</div>


</div>


<script>

let currentHub="";


function escapeHtml(value){

return String(value ?? "")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;");

}


async function loadHub(){

const code=
document.getElementById("hubCode")
.value.trim();

if(!code){

alert("Hub Code enter karein");

return;

}

currentHub=code;

const result=
document.getElementById("result");

result.textContent="Loading...";


try{

const r=
await fetch(
"/api/hub/"+encodeURIComponent(code)
);

const data=await r.json();


if(!r.ok || data.success===false){

result.innerHTML=
`<span class="error">
${escapeHtml(data.message || "Hub not found")}
</span>`;

return;

}


document.getElementById("stats")
.style.display="grid";


const hub=data.hub || {};


document.getElementById("hubStatus")
.textContent=
hub.status || "-";


document.getElementById("hubInfo")
.innerHTML=`

<b>Hub Code:</b>
${escapeHtml(hub.hub_code || code)}
<br>

<b>Name:</b>
${escapeHtml(hub.name || hub.hub_name || "-")}
<br>

<b>City:</b>
${escapeHtml(hub.city || "-")}
<br>

<b>State:</b>
${escapeHtml(hub.state || "-")}
<br>

<b>Status:</b>
${escapeHtml(hub.status || "-")}

`;


result.innerHTML=
`<span class="success">
Hub loaded successfully.
</span>`;


await loadShipments();

await loadPartners();


}catch(e){

result.innerHTML=
`<span class="error">
Server connection error
</span>`;

}

}


async function loadShipments(){

if(!currentHub){

document.getElementById("shipments")
.textContent=
"First load Hub.";

return;

}

const box=
document.getElementById("shipments");

box.textContent="Loading...";


try{

const r=
await fetch(
"/api/hub/"+encodeURIComponent(currentHub)+"/shipments"
);

const data=await r.json();


if(!data.shipments ||
!data.shipments.length){

box.textContent=
"No hub shipments found.";

document.getElementById("shipmentCount")
.textContent="0";

return;

}


document.getElementById("shipmentCount")
.textContent=
data.shipments.length;


box.innerHTML=
data.shipments.map(x=>`

<div style="
padding:9px 0;
border-bottom:1px solid #ddd">

<b>
${escapeHtml(
x.shipment_id || x.id || "-"
)}
</b>

<br>

Status:
${escapeHtml(x.status || "-")}

</div>

`).join("");


}catch(e){

box.textContent=
"Unable to load shipments.";

}

}



async function reservePartnerSeat(){

    const partnerId =
        document.getElementById("seatPartner").value.trim();

    const seatNumber =
        document.getElementById("seatNumber").value.trim();

    const message =
        document.getElementById("seatReservationMessage");

    if(!currentHub){
        message.textContent="Hub not selected.";
        return;
    }

    if(!partnerId || !seatNumber){
        message.textContent=
            "Select a partner and enter a seat number.";
        return;
    }

    message.textContent="Reserving seat...";

    try{

        const r = await fetch(
            "/api/hubs/" +
            encodeURIComponent(currentHub) +
            "/seats/reserve",
            {
                method:"POST",
                headers:{
                    "Content-Type":"application/json"
                },
                body:JSON.stringify({
                    partner_id:partnerId,
                    seat_number:seatNumber
                })
            }
        );

        const data = await r.json();

        if(!r.ok || !data.success){
            throw new Error(
                data.message ||
                "Seat reservation failed"
            );
        }

        message.textContent =
            "Seat " +
            (data.seat.seat_number || seatNumber) +
            " reserved successfully.";

        document.getElementById("seatNumber").value="";

    }catch(e){

        message.textContent =
            e.message || "Seat reservation failed.";

    }
}

async function loadPartners(){

if(!currentHub){

return;

}

const box=
document.getElementById("partners");

box.textContent="Loading...";


try{

const r=
await fetch(
"/api/hub/"+encodeURIComponent(currentHub)+"/partners"
);

const data=await r.json();


document.getElementById("partnerCount")
.textContent=
data.total || 0;

const seatPartner =
document.getElementById("seatPartner");

if (seatPartner) {
    seatPartner.innerHTML =
        '<option value="">Select Partner</option>' +
        (data.partners || []).map(x => `
            <option value="${escapeHtml(
                x.partner_id || x.id || ""
            )}">
                ${escapeHtml(
                    x.name ||
                    x.partner_name ||
                    x.partner_id ||
                    "-"
                )}
            </option>
        `).join("");
}


if(!data.partners ||
!data.partners.length){

box.textContent=
"No partners assigned to this hub.";

return;

}


box.innerHTML=
data.partners.map(x=>`

<div style="
padding:9px 0;
border-bottom:1px solid #ddd">

<b>
${escapeHtml(
x.name ||
x.partner_name ||
x.partner_id ||
x.id ||
"-"
)}
</b>

<br>

Status:
${escapeHtml(x.status || "-")}

</div>

`).join("");


}catch(e){

box.textContent=
"Unable to load partners.";

}

}

</script>

</body>

</html>
