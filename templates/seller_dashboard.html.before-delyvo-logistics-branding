<script>
(function () {

"use strict";


function seller87ShowMessage(id, message, success) {

    const box = document.getElementById(id);

    if (!box) return;

    box.textContent = message;

    box.className =
        "seller87-message " +
        (success ? "success" : "error");

    box.style.display = "block";

    setTimeout(function () {
        box.style.display = "none";
    }, 4000);
}


function seller87Escape(value) {

    const div = document.createElement("div");

    div.textContent =
        value === null || value === undefined
        ? ""
        : String(value);

    return div.innerHTML;
}


function seller87Money(value) {

    const n = Number(value || 0);

    return "₹" + n.toFixed(2);
}


function seller87SellerId() {

    if (
        typeof SELLER_ID !== "undefined" &&
        SELLER_ID !== null
    ) {
        return String(SELLER_ID);
    }

    return "";
}


async function seller87Json(url, options) {

    const response =
        await fetch(url, options || {});

    let data = {};

    try {
        data = await response.json();
    } catch (e) {
        data = {};
    }

    if (!response.ok || data.success === false) {

        throw new Error(
            data.message ||
            ("Request failed (" + response.status + ")")
        );
    }

    return data;
}


/* ==========================================================
   CREATE PRODUCT
   ========================================================== */

async function seller87CreateProduct() {

    const name =
        document.getElementById(
            "seller87ProductName"
        ).value.trim();

    const sku =
        document.getElementById(
            "seller87ProductSku"
        ).value.trim();

    const description =
        document.getElementById(
            "seller87ProductDescription"
        ).value.trim();

    const price =
        Number(
            document.getElementById(
                "seller87ProductPrice"
            ).value
        );

    const stock =
        Number(
            document.getElementById(
                "seller87ProductStock"
            ).value
        );


    if (!name || !sku) {

        seller87ShowMessage(
            "seller87ProductMessage",
            "Product name and SKU are required.",
            false
        );

        return;
    }


    if (!Number.isFinite(price) || price < 0) {

        seller87ShowMessage(
            "seller87ProductMessage",
            "Enter a valid price.",
            false
        );

        return;
    }


    if (!Number.isInteger(stock) || stock < 0) {

        seller87ShowMessage(
            "seller87ProductMessage",
            "Enter a valid stock quantity.",
            false
        );

        return;
    }


    try {

        await seller87Json(
            "/api/sellers/" +
            encodeURIComponent(
                seller87SellerId()
            ) +
            "/products",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    name: name,
                    sku: sku,
                    description: description,
                    price: price,
                    stock: stock
                })
            }
        );


        seller87ShowMessage(
            "seller87ProductMessage",
            "Product created successfully.",
            true
        );


        document.getElementById(
            "seller87ProductName"
        ).value = "";

        document.getElementById(
            "seller87ProductSku"
        ).value = "";

        document.getElementById(
            "seller87ProductDescription"
        ).value = "";

        document.getElementById(
            "seller87ProductPrice"
        ).value = "";

        document.getElementById(
            "seller87ProductStock"
        ).value = "";


        await seller87LoadProducts();

    } catch (error) {

        seller87ShowMessage(
            "seller87ProductMessage",
            error.message,
            false
        );
    }
}


/* ==========================================================
   LOAD PRODUCTS
   ========================================================== */

async function seller87LoadProducts() {

    const body =
        document.getElementById(
            "seller87ProductsBody"
        );

    if (!body) return;

    body.innerHTML =
        '<tr><td colspan="7" class="seller87-empty">Loading products...</td></tr>';

    try {

        const data =
            await seller87Json(
                "/api/sellers/" +
                encodeURIComponent(
                    seller87SellerId()
                ) +
                "/products"
            );

        const products =
            data.products ||
            data.data ||
            [];


        if (!products.length) {

            body.innerHTML =
                '<tr><td colspan="7" class="seller87-empty">No products found.</td></tr>';

            return;
        }


        body.innerHTML =
            products.map(function (product) {

                const id =
                    product.product_id ||
                    product.id ||
                    "";

                const status =
                    product.status ||
                    "ACTIVE";


                return `
<tr>

<td>${seller87Escape(id)}</td>

<td>${seller87Escape(product.name)}</td>

<td>${seller87Escape(product.sku)}</td>

<td>${seller87Money(product.price)}</td>

<td>${seller87Escape(product.stock)}</td>

<td>
<span class="seller87-badge">
${seller87Escape(status)}
</span>
</td>

<td>

<div class="seller87-actions">

<button
class="seller87-btn"
type="button"
data-action="stock"
data-id="${seller87Escape(id)}">
Stock
</button>

<button
class="seller87-btn secondary"
type="button"
data-action="status"
data-id="${seller87Escape(id)}">
Status
</button>

<button
class="seller87-btn danger"
type="button"
data-action="delete"
data-id="${seller87Escape(id)}">
Delete
</button>

</div>

</td>

</tr>
`;

            }).join("");


    } catch (error) {

        body.innerHTML =
            '<tr><td colspan="7" class="seller87-empty">' +
            seller87Escape(error.message) +
            '</td></tr>';
    }
}


/* ==========================================================
   UPDATE STOCK
   ========================================================== */

async function seller87UpdateStock(productId) {

    const value =
        prompt("Enter new stock quantity:");

    if (value === null) return;

    const stock = Number(value);

    if (
        !Number.isInteger(stock) ||
        stock < 0
    ) {

        alert("Invalid stock quantity.");

        return;
    }


    try {

        await seller87Json(
            "/api/sellers/" +
            encodeURIComponent(
                seller87SellerId()
            ) +
            "/products/" +
            encodeURIComponent(productId) +
            "/stock",
            {
                method: "PATCH",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    stock: stock
                })
            }
        );

        await seller87LoadProducts();

    } catch (error) {

        alert(error.message);
    }
}


/* ==========================================================
   UPDATE PRODUCT STATUS
   ========================================================== */

async function seller87UpdateStatus(productId) {

    const value =
        prompt(
            "Enter status: ACTIVE or INACTIVE",
            "ACTIVE"
        );

    if (value === null) return;

    const status =
        value.trim().toUpperCase();


    if (
        status !== "ACTIVE" &&
        status !== "INACTIVE"
    ) {

        alert(
            "Status must be ACTIVE or INACTIVE."
        );

        return;
    }


    try {

        await seller87Json(
            "/api/sellers/" +
            encodeURIComponent(
                seller87SellerId()
            ) +
            "/products/" +
            encodeURIComponent(productId) +
            "/status",
            {
                method: "PATCH",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    status: status
                })
            }
        );

        await seller87LoadProducts();

    } catch (error) {

        alert(error.message);
    }
}


/* ==========================================================
   DELETE PRODUCT
   ========================================================== */

async function seller87DeleteProduct(productId) {

    if (
        !confirm(
            "Are you sure you want to delete this product?"
        )
    ) {
        return;
    }


    try {

        await seller87Json(
            "/api/sellers/" +
            encodeURIComponent(
                seller87SellerId()
            ) +
            "/products/" +
            encodeURIComponent(productId),
            {
                method: "DELETE"
            }
        );

        await seller87LoadProducts();

    } catch (error) {

        alert(error.message);
    }
}


/* ==========================================================
   CREATE ORDER
   ========================================================== */

async function seller87CreateOrder() {

    const customerName =
        document.getElementById(
            "seller87CustomerName"
        ).value.trim();

    const customerPhone =
        document.getElementById(
            "seller87CustomerPhone"
        ).value.trim();

    const address =
        document.getElementById(
            "seller87Address"
        ).value.trim();

    const productId =
        document.getElementById(
            "seller87ProductId"
        ).value.trim();

    const quantity =
        Number(
            document.getElementById(
                "seller87Quantity"
            ).value
        );

    const payment =
        document.getElementById(
            "seller87Payment"
        ).value;

    const deliveryFee =
        Number(
            document.getElementById(
                "seller87DeliveryFee"
            ).value
        );


    if (
        !customerName ||
        !customerPhone ||
        !address ||
        !productId
    ) {

        seller87ShowMessage(
            "seller87OrderMessage",
            "Customer, phone, address and product ID are required.",
            false
        );

        return;
    }


    if (
        !Number.isInteger(quantity) ||
        quantity < 1
    ) {

        seller87ShowMessage(
            "seller87OrderMessage",
            "Enter a valid quantity.",
            false
        );

        return;
    }


    if (
        !Number.isFinite(deliveryFee) ||
        deliveryFee < 0
    ) {

        seller87ShowMessage(
            "seller87OrderMessage",
            "Enter a valid delivery fee.",
            false
        );

        return;
    }


    try {

        await seller87Json(
            "/api/sellers/" +
            encodeURIComponent(
                seller87SellerId()
            ) +
            "/orders",
            {
                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    customer_name: customerName,
                    customer_phone: customerPhone,
                    delivery_address: address,
                    product_id: productId,
                    quantity: quantity,
                    payment_type: payment,
                    delivery_fee: deliveryFee
                })
            }
        );


        seller87ShowMessage(
            "seller87OrderMessage",
            "Order created successfully.",
            true
        );


        document.getElementById(
            "seller87CustomerName"
        ).value = "";

        document.getElementById(
            "seller87CustomerPhone"
        ).value = "";

        document.getElementById(
            "seller87Address"
        ).value = "";

        document.getElementById(
            "seller87ProductId"
        ).value = "";

        document.getElementById(
            "seller87Quantity"
        ).value = "1";

        document.getElementById(
            "seller87DeliveryFee"
        ).value = "0";


        await seller87LoadOrders();
        await seller87LoadProducts();

    } catch (error) {

        seller87ShowMessage(
            "seller87OrderMessage",
            error.message,
            false
        );
    }
}


/* ==========================================================
   LOAD ORDERS
   ========================================================== */

async function seller87LoadOrders() {

    const body =
        document.getElementById(
            "seller87OrdersBody"
        );

    if (!body) return;

    body.innerHTML =
        '<tr><td colspan="7" class="seller87-empty">Loading orders...</td></tr>';


    try {

        const data =
            await seller87Json(
                "/api/sellers/" +
                encodeURIComponent(
                    seller87SellerId()
                ) +
                "/orders"
            );


        const orders =
            data.orders ||
            data.data ||
            [];


        if (!orders.length) {

            body.innerHTML =
                '<tr><td colspan="7" class="seller87-empty">No orders found.</td></tr>';

            return;
        }


        body.innerHTML =
            orders.map(function (order) {

                const id =
                    order.order_id ||
                    order.id ||
                    "";

                const customer =
                    order.customer_name ||
                    order.customer ||
                    "";

                const phone =
                    order.customer_phone ||
                    order.phone ||
                    "";

                const payment =
                    order.payment_type ||
                    order.payment ||
                    "";

                const status =
                    order.status ||
                    "PENDING";

                const total =
                    order.total ||
                    order.total_amount ||
                    order.amount ||
                    0;


                return `
<tr>

<td>${seller87Escape(id)}</td>

<td>${seller87Escape(customer)}</td>

<td>${seller87Escape(phone)}</td>

<td>${seller87Escape(payment)}</td>

<td>
<span class="seller87-badge">
${seller87Escape(status)}
</span>
</td>

<td>${seller87Money(total)}</td>

<td>

<div class="seller87-actions">

<button
class="seller87-btn"
type="button"
data-order-action="status"
data-order-id="${seller87Escape(id)}">
Status
</button>

</div>

</td>

</tr>
`;

            }).join("");


    } catch (error) {

        body.innerHTML =
            '<tr><td colspan="7" class="seller87-empty">' +
            seller87Escape(error.message) +
            '</td></tr>';
    }
}


/* ==========================================================
   UPDATE ORDER STATUS
   ========================================================== */

async function seller87UpdateOrderStatus(orderId) {

    const value =
        prompt(
            "Enter order status:",
            "PENDING"
        );

    if (value === null) return;

    const status =
        value.trim().toUpperCase();


    if (!status) {

        alert("Status is required.");

        return;
    }


    try {

        await seller87Json(
            "/api/sellers/" +
            encodeURIComponent(
                seller87SellerId()
            ) +
            "/orders/" +
            encodeURIComponent(orderId) +
            "/status",
            {
                method: "PATCH",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body: JSON.stringify({
                    status: status
                })
            }
        );

        await seller87LoadOrders();

    } catch (error) {

        alert(error.message);
    }
}


/* ==========================================================
   CLICK EVENTS
   ========================================================== */

document.addEventListener(
    "click",
    function (event) {

        const productButton =
            event.target.closest(
                "[data-action]"
            );


        if (productButton) {

            const action =
                productButton.dataset.action;

            const id =
                productButton.dataset.id;


            if (action === "stock") {
                seller87UpdateStock(id);
            }

            else if (action === "status") {
                seller87UpdateStatus(id);
            }

            else if (action === "delete") {
                seller87DeleteProduct(id);
            }

            return;
        }


        const orderButton =
            event.target.closest(
                "[data-order-action]"
            );


        if (orderButton) {

            const action =
                orderButton.dataset.orderAction;

            const id =
                orderButton.dataset.orderId;


            if (action === "status") {
                seller87UpdateOrderStatus(id);
            }
        }

    }
);


/* ==========================================================
   BUTTON EVENTS
   ========================================================== */

const addProductButton =
    document.getElementById(
        "seller87AddProductBtn"
    );

if (addProductButton) {

    addProductButton.addEventListener(
        "click",
        seller87CreateProduct
    );
}


const createOrderButton =
    document.getElementById(
        "seller87CreateOrderBtn"
    );

if (createOrderButton) {

    createOrderButton.addEventListener(
        "click",
        seller87CreateOrder
    );
}


const refreshProducts =
    document.getElementById(
        "seller87RefreshProducts"
    );

if (refreshProducts) {

    refreshProducts.addEventListener(
        "click",
        seller87LoadProducts
    );
}


const refreshOrders =
    document.getElementById(
        "seller87RefreshOrders"
    );

if (refreshOrders) {

    refreshOrders.addEventListener(
        "click",
        seller87LoadOrders
    );
}


/* ==========================================================
   INITIAL LOAD
   ========================================================== */

seller87LoadProducts();
seller87LoadOrders();

})();
</script>

