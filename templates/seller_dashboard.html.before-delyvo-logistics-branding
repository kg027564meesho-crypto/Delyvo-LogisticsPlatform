<script>
    const SELLER_ID = "{{ seller_id }}";

    function money(value) {
        return "₹" + Number(value || 0).toFixed(2);
    }

    function escapeHtml(value) {
        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function showError(message) {
        const box = document.getElementById("errorBox");
        box.textContent = message;
        box.style.display = "block";
    }

    function clearError() {
        const box = document.getElementById("errorBox");
        box.style.display = "none";
        box.textContent = "";
    }

    async function loadDashboard() {
        clearError();

        document.getElementById("loading").style.display = "block";
        document.getElementById("dashboard").style.display = "none";

        try {
            const response = await fetch(
                "/api/sellers/" +
                encodeURIComponent(SELLER_ID) +
                "/dashboard"
            );

            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(
                    data.message || "Dashboard request failed"
                );
            }

            renderDashboard(data);

        } catch (error) {
            showError(error.message);
        } finally {
            document.getElementById("loading").style.display = "none";
        }
    }

    function renderDashboard(data) {
        const seller = data.seller || {};
        const products = (data.summary || {}).products || {};
        const orders = (data.summary || {}).orders || {};

        document.getElementById("sellerName").textContent =
            seller.name || "Seller";

        document.getElementById("sellerId").textContent =
            seller.seller_id || SELLER_ID;

        document.getElementById("sellerPhone").textContent =
            seller.phone || "-";

        document.getElementById("sellerStatus").textContent =
            seller.status || "-";

        document.getElementById("totalProducts").textContent =
            products.total || 0;

        document.getElementById("activeProducts").textContent =
            products.active || 0;

        document.getElementById("totalStock").textContent =
            products.total_stock || 0;

        document.getElementById("lowStock").textContent =
            (data.low_stock_products || []).length;

        document.getElementById("totalOrders").textContent =
            orders.total || 0;

        document.getElementById("placedOrders").textContent =
            orders.placed || 0;

        document.getElementById("deliveredOrders").textContent =
            orders.delivered || 0;

        document.getElementById("orderValue").textContent =
            money(orders.total_order_value);

        renderOrders(data.recent_orders || []);
        renderProducts(data.low_stock_products || []);

        document.getElementById("dashboard").style.display = "block";
    }

    function renderOrders(orders) {
        const body = document.getElementById("ordersBody");
        const empty = document.getElementById("ordersEmpty");

        body.innerHTML = "";

        if (!orders.length) {
            empty.style.display = "block";
            return;
        }

        empty.style.display = "none";

        orders.forEach(order => {
            const status = escapeHtml(order.order_status || "-");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>${escapeHtml(order.order_id)}</td>
                <td>${escapeHtml(order.customer_name)}</td>
                <td>${escapeHtml(order.payment_type)}</td>
                <td>
                    <span class="badge active">
                        ${status}
                    </span>
                </td>
                <td>${money(order.total_amount)}</td>
                <td>${escapeHtml(order.created_at || "-")}</td>
            `;

            body.appendChild(row);
        });
    }

    function renderProducts(products) {
        const body = document.getElementById("productsBody");
        const empty = document.getElementById("productsEmpty");

        body.innerHTML = "";

        if (!products.length) {
            empty.style.display = "block";
            return;
        }

        empty.style.display = "none";

        products.forEach(product => {
            const row = document.createElement("tr");

            row.innerHTML = `
                <td>${escapeHtml(product.product_id)}</td>
                <td>${escapeHtml(product.name)}</td>
                <td>${escapeHtml(product.sku || "-")}</td>
                <td>${money(product.price)}</td>
                <td>
                    <span class="badge warning">
                        ${escapeHtml(product.stock)}
                    </span>
                </td>
                <td>
                    <span class="badge active">
                        ${escapeHtml(product.status)}
                    </span>
                </td>
            `;

            body.appendChild(row);
        });
    }

    loadDashboard();
</script>





