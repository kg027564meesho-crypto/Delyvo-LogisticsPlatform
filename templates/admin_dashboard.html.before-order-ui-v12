<script>

async function getJSON(url){
 const response = await fetch(url);
 return await response.json();
}

async function loadDashboard(){

 try{

  const data = await getJSON("/api/admin/dashboard");

  if(!data.success) return;

  const s = data.statistics || {};

  document.getElementById("companies").textContent=s.companies||0;
  document.getElementById("sellers").textContent=s.sellers||0;
  document.getElementById("shipments").textContent=s.shipments||0;
  document.getElementById("partners").textContent=s.partners||0;
  document.getElementById("hubs").textContent=s.hubs||0;
  document.getElementById("products").textContent=s.products||0;
  document.getElementById("orders").textContent=s.orders||0;
  document.getElementById("payments").textContent=s.payments||0;

 }catch(e){
  console.error(e);
 }
}


async function loadProducts(){

 const box=document.getElementById("productBox");

 try{

  const data=await getJSON("/api/admin/products");

  if(!data.success){
   box.innerHTML='<div class="empty">Unable to load products.</div>';
   return;
  }

  window.delyvoProducts=data.products || [];

  updateProductSummary(data.summary || {});
  buildProductSellerFilter(window.delyvoProducts);
  renderProducts(window.delyvoProducts);

 }catch(e){

  console.error(e);
  box.innerHTML='<div class="empty">Unable to load products.</div>';

 }
}


async function loadProductSummary(){

 try{

  const data=await getJSON("/api/admin/products/summary");

  if(data.success){
   updateProductSummary(data.summary || {});
  }

 }catch(e){

  console.error(e);

 }
}


function updateProductSummary(s){

 document.getElementById("productTotal").textContent=s.total||0;
 document.getElementById("productActive").textContent=s.active||0;
 document.getElementById("productInactive").textContent=s.inactive||0;
 document.getElementById("productLowStock").textContent=s.low_stock||0;
 document.getElementById("productOutStock").textContent=s.out_of_stock||0;

}


function buildProductSellerFilter(products){

 const select=document.getElementById("productSellerFilter");
 const current=select.value;

 const sellers={};

 products.forEach(x=>{

  if(x.seller_id){

   sellers[x.seller_id]=
    x.seller_name || x.seller_id;

  }

 });

 select.innerHTML='<option value="">All Sellers</option>';

 Object.keys(sellers)
  .sort((a,b)=>String(sellers[a]).localeCompare(String(sellers[b])))
  .forEach(id=>{

   const option=document.createElement("option");

   option.value=id;
   option.textContent=
    `${sellers[id]} (${id})`;

   select.appendChild(option);

  });

 select.value=current;

}


function renderProducts(products){

 const box=document.getElementById("productBox");

 if(!products.length){

  box.innerHTML='<div class="empty">No products found.</div>';

  return;

 }

 let html="<table><tr>"+
  "<th>Product</th>"+
  "<th>SKU</th>"+
  "<th>Seller</th>"+
  "<th>Price</th>"+
  "<th>Stock</th>"+
  "<th>Status</th>"+
  "<th>Actions</th>"+
  "</tr>";

 products.forEach(x=>{

  const stock=Number(x.stock||0);

  const stockLabel=
   stock===0
    ? "OUT"
    : stock<=5
     ? "LOW"
     : String(stock);

  html+=`<tr>

   <td>
    <strong>${escapeProduct(x.name||"-")}</strong><br>
    <small>${escapeProduct(x.product_id||"")}</small>
   </td>

   <td>${escapeProduct(x.sku||"-")}</td>

   <td>
    ${escapeProduct(x.seller_name||"-")}<br>
    <small>${escapeProduct(x.seller_id||"")}</small>
   </td>

   <td>₹${Number(x.price||0).toFixed(2)}</td>

   <td class="status">${stockLabel}</td>

   <td class="status">${escapeProduct(x.status||"-")}</td>

   <td>
    <button onclick='viewAdminProduct(${JSON.stringify(x.product_id)})'>
     View
    </button>
    <button onclick='changeProductStock(${JSON.stringify(x.product_id)},${stock})'>
     Stock
    </button>
    <button onclick='toggleProductStatus(${JSON.stringify(x.product_id)},${JSON.stringify(x.status)})'>
     ${String(x.status||"").toUpperCase()==="ACTIVE" ? "Deactivate" : "Activate"}
    </button>
   </td>

  </tr>`;

 });

 html+="</table>";

 box.innerHTML=html;

}


function filterProducts(){

 const q=
  (document.getElementById("productSearch").value||"")
   .trim()
   .toLowerCase();

 const seller=
  document.getElementById("productSellerFilter").value||"";

 const status=
  document.getElementById("productStatusFilter").value||"";

 const stock=
  document.getElementById("productStockFilter").value||"";

 const products=window.delyvoProducts||[];

 const filtered=products.filter(x=>{

  const matchesSearch=[
   x.product_id,
   x.name,
   x.sku,
   x.seller_id,
   x.seller_name,
   x.seller_company
  ].some(v=>
   String(v||"").toLowerCase().includes(q)
  );

  const matchesSeller=
   !seller || String(x.seller_id||"")===seller;

  const matchesStatus=
   !status ||
   String(x.status||"").toUpperCase()===status;

  const stockValue=Number(x.stock||0);

  const matchesStock=
   !stock ||
   (stock==="low" && stockValue<=5) ||
   (stock==="out" && stockValue===0);

  return matchesSearch &&
         matchesSeller &&
         matchesStatus &&
         matchesStock;

 });

 renderProducts(filtered);

}


function escapeProduct(value){

 return String(value)
  .replace(/&/g,"&amp;")
  .replace(/</g,"&lt;")
  .replace(/>/g,"&gt;")
  .replace(/"/g,"&quot;")
  .replace(/'/g,"&#039;");

}


async function viewAdminProduct(productId){

 try{

  const data=
   await getJSON(
    "/api/admin/products/"+encodeURIComponent(productId)
   );

  if(!data.success){

   alert(data.message||"Product not found");
   return;

  }

  const x=data.product||{};

  alert(
`PRODUCT DETAILS

Product: ${x.name||"-"}
Product ID: ${x.product_id||"-"}
SKU: ${x.sku||"-"}
Price: ₹${Number(x.price||0).toFixed(2)}
Stock: ${x.stock||0}
Status: ${x.status||"-"}

SELLER

Name: ${x.seller_name||"-"}
Seller ID: ${x.seller_id||"-"}
Company: ${x.seller_company||"-"}
Phone: ${x.seller_phone||"-"}
Email: ${x.seller_email||"-"}
City: ${x.seller_city||"-"}

Description:
${x.description||"-"}`
  );

 }catch(e){

  console.error(e);
  alert("Unable to load product details.");

 }

}


async function changeProductStock(productId,currentStock){

 const value=prompt(
  "Enter new stock:",
  String(currentStock)
 );

 if(value===null) return;

 const stock=Number(value);

 if(!Number.isInteger(stock) || stock<0){

  alert("Enter a valid non-negative whole number.");
  return;

 }

 try{

  const response=await fetch(
   "/api/admin/products/"+encodeURIComponent(productId)+"/stock",
   {
    method:"POST",
    headers:{
     "Content-Type":"application/json"
    },
    body:JSON.stringify({
     stock:stock
    })
   }
  );

  const data=await response.json();

  if(!data.success){

   alert(data.message||"Stock update failed");
   return;

  }

  await loadProducts();

 }catch(e){

  console.error(e);
  alert("Unable to update stock.");

 }

}


async function toggleProductStatus(productId,currentStatus){

 const newStatus=
  String(currentStatus||"").toUpperCase()==="ACTIVE"
   ? "INACTIVE"
   : "ACTIVE";

 if(!confirm(
  "Change product status to "+newStatus+"?"
 )) return;

 try{

  const response=await fetch(
   "/api/admin/products/"+encodeURIComponent(productId)+"/status",
   {
    method:"POST",
    headers:{
     "Content-Type":"application/json"
    },
    body:JSON.stringify({
     status:newStatus
    })
   }
