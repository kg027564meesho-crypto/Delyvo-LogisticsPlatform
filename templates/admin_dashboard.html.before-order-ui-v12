   )}

   ${productDetailItem(
    "New Status",
    newStatus
   )}

  </div>

  <div style="margin-top:14px;color:#64748b;font-size:13px">
   Are you sure you want to change this product status?
  </div>
 `;

 document.getElementById("statusModal").classList.add("show");

}


async function submitProductStatus(){

 if(!v11StatusProductId ||
    !v11StatusNewValue){

  showProductToast("Product status not selected.");
  return;

 }

 try{

  const response=await fetch(
   "/api/admin/products/"+
   encodeURIComponent(v11StatusProductId)+
   "/status",
   {
    method:"POST",
    headers:{
     "Content-Type":"application/json"
    },
    body:JSON.stringify({
     status:v11StatusNewValue
    })
   }
  );

  const data=await response.json();

  if(!data.success){

   showProductToast(
    data.message||"Status update failed"
   );

   return;

  }

  closeStatusModal();

  showProductToast(
   "Product status updated successfully."
  );

  await loadProducts();

 }catch(e){

  console.error(e);
  showProductToast(
   "Unable to update product status."
  );

 }

}


document.addEventListener("keydown",function(event){

 if(event.key==="Escape"){

  closeProductModal();
  closeStockModal();
  closeStatusModal();

 }

});


</script>


