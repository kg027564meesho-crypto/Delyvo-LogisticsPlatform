async function submitProductStock(){

 const input=document.getElementById("stockInput");

 const stock=Number(input.value);

 if(!Number.isInteger(stock) || stock<0){

  showProductToast("Enter a valid non-negative whole number.");
  input.focus();
  return;

 }

 if(!v11StockProductId){

  showProductToast("Product not selected.");
  return;

 }

 try{

  const response=await fetch(
   "/api/admin/products/"+
   encodeURIComponent(v11StockProductId)+
   "/stock",
   {
    method:"POST",
    headers:{
     "Content-Type":"application/json"
    },
    body:JSON.stringify({
     stock:stock
    })
   }
  );

  const data=await response.json();

  if(!data.success){

   showProductToast(
    data.message||"Stock update failed"
   );

   return;

  }

  closeStockModal();

  showProductToast(
   "Stock updated successfully."
  );

  await loadProducts();

 }catch(e){

  console.error(e);
  showProductToast(
   "Unable to update stock."
  );

 }

}


