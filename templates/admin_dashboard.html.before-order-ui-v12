<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Delyvo Logistics - Admin Control Center</title>

<style>
*{box-sizing:border-box}

body{
 margin:0;
 font-family:Arial,Helvetica,sans-serif;
 background:#f4f7fb;
 color:#172033;
}

header{
 background:#111827;
 color:white;
 padding:16px 20px;
 position:sticky;
 top:0;
 z-index:10;
}

.header-inner{
 max-width:1200px;
 margin:auto;
 display:flex;
 justify-content:space-between;
 align-items:center;
}

.logo{
 font-size:23px;
 font-weight:800;
}

.logo span{color:#39d98a}

.online{
 color:#8ff0bd;
 font-size:13px;
}

.container{
 max-width:1200px;
 margin:auto;
 padding:20px;
}

.hero{
 background:linear-gradient(135deg,#111827,#1f3b55);
 color:white;
 padding:25px;
 border-radius:18px;
 margin-bottom:20px;
}

.hero h1{margin:0 0 8px}
.hero p{margin:0;color:#cbd5e1}

.stats{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:14px;
 margin-bottom:20px;
}

.stat{
 background:white;
 border-radius:16px;
 padding:18px;
 box-shadow:0 3px 14px #00000010;
}

.label{
 color:#64748b;
 font-size:13px;
}

.number{
 font-size:30px;
 font-weight:800;
 margin-top:7px;
}

.section{
 background:white;
 border-radius:16px;
 padding:18px;
 margin-bottom:18px;
 box-shadow:0 3px 14px #00000010;
}

.section-head{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:10px;
 margin-bottom:14px;
}

.section h2{
 margin:0;
 font-size:19px;
}

button{
 border:0;
 border-radius:9px;
 padding:10px 14px;
 background:#111827;
 color:white;
 font-weight:700;
 cursor:pointer;
}

button:hover{
 background:#263449;
}

.result{
 overflow:auto;
}

table{
 width:100%;
 border-collapse:collapse;
 min-width:700px;
}

th,td{
 text-align:left;
 padding:10px;
 border-bottom:1px solid #e5e7eb;
 font-size:13px;
}

th{
 background:#f8fafc;
 color:#475569;
}

.status{
 font-weight:700;
}

.empty{
 color:#64748b;
 padding:15px 0;
}

@media(max-width:800px){
 .stats{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:500px){
 .container{padding:12px}
 .stats{grid-template-columns:1fr 1fr}
 .number{font-size:24px}
}

/* ============================================================
   PRODUCT MANAGEMENT V11
   ============================================================ */

.product-grid{
 display:grid;
 grid-template-columns:repeat(5,1fr);
 gap:10px;
}

.product-actions{
 display:flex;
 flex-wrap:wrap;
 gap:6px;
}

.product-actions button{
 padding:7px 9px;
 font-size:12px;
}

.product-modal{
 display:none;
 position:fixed;
 inset:0;
 background:rgba(15,23,42,.62);
 z-index:1000;
 align-items:center;
 justify-content:center;
 padding:16px;
}

.product-modal.show{
 display:flex;
}

.product-modal-card{
 width:100%;
 max-width:560px;
 max-height:90vh;
 overflow:auto;
 background:white;
 border-radius:18px;
 box-shadow:0 20px 60px rgba(0,0,0,.25);
}

.product-modal-head{
 display:flex;
 justify-content:space-between;
 align-items:center;
 padding:18px 20px;
 border-bottom:1px solid #e5e7eb;
 position:sticky;
 top:0;
 background:white;
 z-index:2;
}

.product-modal-head h3{
 margin:0;
 font-size:19px;
}

.product-modal-close{
 background:#f1f5f9;
 color:#172033;
 width:36px;
 height:36px;
 padding:0;
 border-radius:50%;
 font-size:20px;
}

.product-modal-body{
 padding:20px;
}

.product-detail-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
}

.product-detail-item{
 background:#f8fafc;
 border-radius:11px;
 padding:12px;
}

.product-detail-label{
 font-size:11px;
 color:#64748b;
 margin-bottom:4px;
}

.product-detail-value{
 font-size:14px;
 font-weight:700;
 word-break:break-word;
}

.product-form-group{
 margin-bottom:14px;
}

.product-form-group label{
 display:block;
 font-size:13px;
 font-weight:700;
 margin-bottom:6px;
 color:#334155;
}

.product-form-group input{
 width:100%;
 padding:12px;
 border:1px solid #cbd5e1;
 border-radius:10px;
 font-size:15px;
 outline:none;
}

.product-form-group input:focus{
 border-color:#64748b;
}

.product-modal-footer{
 display:flex;
 justify-content:flex-end;
 gap:8px;
 padding:14px 20px;
 border-top:1px solid #e5e7eb;
}

.product-btn-secondary{
 background:#e2e8f0;
 color:#172033;
}

.product-btn-danger{
 background:#b91c1c;
}

.product-status-badge{
 display:inline-block;
 padding:4px 8px;
 border-radius:999px;
 font-size:11px;
 font-weight:800;
 background:#e2e8f0;
}

.product-stock-low{
 font-weight:800;
}

.product-stock-out{
 font-weight:800;
}

#productToast{
 position:fixed;
 right:18px;
 bottom:18px;
 z-index:2000;
 display:none;
 max-width:360px;
 padding:13px 16px;
 border-radius:11px;
 background:#111827;
 color:white;
 font-size:14px;
 font-weight:700;
 box-shadow:0 10px 30px rgba(0,0,0,.2);
}

@media(max-width:900px){
 .product-grid{
  grid-template-columns:repeat(3,1fr);
 }
}

@media(max-width:650px){
 .product-grid{
  grid-template-columns:1fr 1fr;
 }

 .product-detail-grid{
  grid-template-columns:1fr;
 }

 .product-modal{
  padding:8px;
  align-items:flex-end;
 }

 .product-modal-card{
  max-height:94vh;
  border-radius:18px 18px 0 0;
 }

 table{
  min-width:850px;
 }
}

@media(max-width:420px){
 .product-grid{
  grid-template-columns:1fr;
 }
}

</style>
</head>

