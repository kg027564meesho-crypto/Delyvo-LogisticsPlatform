<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delyvo Partner</title>
    <link rel="stylesheet" href="/static/partner_app.css">
</head>

<body>
<div class="app">

<header class="topbar">
    <div class="topbar-row">
        <div class="brand">Delyvo</div>
        <button class="top-action" onclick="loadAll()">↻</button>
    </div>
</header>

<div id="homePage" class="page active">

<div class="welcome">
    <h1 id="appWelcome">Welcome 👋</h1>
    <p>Your delivery partner dashboard</p>
</div>

<header class="topbar">
    <div>
        <div class="brand">Delyvo Partner</div>
        <div class="subtitle">Delivery Operations</div>
    </div>

</header>

<section class="partner-card">
    <div>
        <h1 id="partnerName">Partner</h1>
        <p id="partnerMeta">Loading...</p>
    </div>
    <div class="partner-id" id="partnerId"></div>
</section>

<section class="hero">
    <div>
        <span class="eyebrow">TODAY'S EARNINGS</span>
        <strong id="totalEarnings">₹0</strong>
        <small>Completed delivery earnings</small>
    </div>
    <div class="hero-side">
        <span>Pending</span>
        <b id="pendingEarnings">₹0</b>
    </div>
</section>

<section class="cards">
    <div class="card">
        <span>Active</span>
        <strong id="activeAssignments">0</strong>
    </div>

    <div class="card">
        <span>Completed</span>
        <strong id="completedAssignments">0</strong>
    </div>

    <div class="card">
        <span>RTO</span>
        <strong id="rtoAssignments">0</strong>
    </div>

    <div class="card">
        <span>COD Collected</span>
        <strong id="codCollected">₹0</strong>
    </div>
</section>

<section class="panel pending-panel">
    <div class="panel-title">
        <h2>Pending Confirmation</h2>
        <span id="pendingCount" class="pending-count">0</span>
    </div>

    <div id="pendingAssignments">
        Loading...
    </div>
</section>

<section class="panel">
    <div class="panel-title">
        <h2>Active Deliveries</h2>
        <button onclick="loadAll()">Refresh</button>
    </div>

    <div id="activeDeliveries">
        Loading...
    </div>
</section>

<section class="panel">
    <div class="panel-title">
        <h2>COD Collection</h2>
        <span id="codPending">₹0 pending</span>
    </div>

    <div class="cod-summary">
        <div>
            <span>Collected</span>
            <b id="codCollected2">₹0</b>
        </div>

        <div>
            <span>Payments</span>
            <b id="codPayments">0</b>
        </div>
    </div>
</section>

<section class="panel">
    <div class="panel-title">
        <h2>Recent Earnings</h2>
    </div>

    <div id="earningsList">
        Loading...
    </div>
</section>
</div>

</div>

<div id="deliveriesPage" class="page">
    <div class="welcome">
        <h1>Deliveries</h1>
        <p>Manage your assigned shipments</p>
    </div>

    <section class="section">
        <div class="section-head">
            <h2>Pending Confirmation</h2>
            <button onclick="loadPendingAssignments()">Refresh</button>
        </div>
        <div id="deliveriesPending"></div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>Active Deliveries</h2>
        </div>
        <div id="deliveriesActive"></div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>Delivery History</h2>
            <button onclick="loadDeliveryHistory()">Refresh</button>
        </div>
        <div id="deliveryHistory"></div>
    </section>
</div>

<div id="earningsPage" class="page">
    <div class="welcome">
        <h1>Earnings</h1>
        <p>Track your delivery income</p>
    </div>

    <section class="earnings">
        <div class="earnings-label">TOTAL EARNINGS</div>
        <div id="earningsPageTotal" class="earnings-value">₹0</div>
        <div class="earnings-sub">Your completed delivery earnings</div>
    </section>

    <section class="section">
        <div class="section-head">
            <h2>Recent Earnings</h2>
        </div>
        <div id="earningsPageList"></div>
    </section>
</div>

<div id="profilePage" class="page">
    <div class="welcome">
        <h1>Profile</h1>
        <p>Your partner information</p>
    </div>

    <div class="profile">
        <div class="avatar" id="profileAvatar">P</div>
        <h2 id="profileName">Partner</h2>
        <p id="profileId">Partner ID</p>

        <div class="info-row">
            <span>Phone</span>
            <b id="profilePhone">-</b>
        </div>

        <div class="info-row">
            <span>City</span>
            <b id="profileCity">-</b>
        </div>

        <div class="info-row">
            <span>Vehicle</span>
            <b id="profileVehicle">-</b>
        </div>
    </div>
</div>

<nav class="bottom-nav">
    <button class="nav-btn active" onclick="showPage('homePage',this)">
        <span>⌂</span>Home
    </button>

    <button class="nav-btn" onclick="showPage('deliveriesPage',this)">
        <span>▣</span>Deliveries
    </button>

    <button class="nav-btn" onclick="showPage('earningsPage',this)">
        <span>₹</span>Earnings
    </button>

    <button class="nav-btn" onclick="showPage('profilePage',this)">
        <span>●</span>Profile
    </button>
</nav>

<script>
const partnerId =
    new URLSearchParams(window.location.search).get("partner_id")
    || "PTR-5CAAB579";

function money(value) {
    return "₹" + Number(value || 0).toLocaleString("en-IN", {
        maximumFractionDigits: 2
    });
}

function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
}

function escapeHtml(value) {
    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

async function loadDashboard() {
    const response = await fetch(
        `/api/partners/${encodeURIComponent(partnerId)}/dashboard`
    );

    const data = await response.json();

    if (!response.ok || !data.success) {
        throw new Error(data.message || "Dashboard request failed");
    }

    const partner = data.partner;
    const dashboard = data.dashboard;
    const earnings = data.earnings;

    updateProfessionalProfile(partner);
    updateEarningsPage(earnings);

    setText("partnerName", partner.name);
    setText(
        "partnerMeta",
        `${partner.city} • ${partner.vehicle_type} • ${partner.phone}`
    );
    setText("partnerId", partner.partner_id);

    setText("totalEarnings", money(earnings.total_amount));
    setText("pendingEarnings", money(earnings.pending_amount));

    setText("activeAssignments", dashboard.assignments.active);
    setText("completedAssignments", dashboard.assignments.completed);
    setText("rtoAssignments", dashboard.assignments.rto);

    setText("codCollected", money(dashboard.cod.collected_amount));
    setText("codCollected2", money(dashboard.cod.collected_amount));
    setText("codPayments", dashboard.cod.collected_payments);
    setText("codPending", money(dashboard.cod.pending_amount) + " pending");

    renderEarnings(earnings.recent || []);
}

function renderEarnings(items) {
    const container = document.getElementById("earningsList");

    if (!items.length) {
        container.innerHTML =
            '<div class="empty">No earnings available.</div>';
        return;
    }

    container.innerHTML = items.map(item => `
        <div class="earning">
            <div>
                <strong>${escapeHtml(item.earning_type)}</strong>
                <small>${escapeHtml(item.shipment_id)}</small>
            </div>

            <div class="earning-right">
                <strong>${money(item.amount)}</strong>
                <span class="badge ${String(item.status).toLowerCase()}">
                    ${escapeHtml(item.status)}
                </span>
            </div>
        </div>
    `).join("");
}

async function loadPendingAssignments() {
    const container = document.getElementById("pendingAssignments");
    const count = document.getElementById("pendingCount");

    try {
        const response = await fetch(
            `/api/partners/${encodeURIComponent(partnerId)}/active-assignments`
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.message || "Assignments request failed");
        }

        const assignments = data.assignments || [];

        const pending = assignments.filter(
            item => String(item.status).toUpperCase() === "ASSIGNED"
        );

        count.textContent = pending.length;

        if (!pending.length) {
            container.innerHTML =
                '<div class="empty">No shipments waiting for confirmation.</div>';
        } else {
            container.innerHTML = pending.map(renderAssignment).join("");

            container.querySelectorAll(".confirm-btn").forEach(button => {
                button.onclick = () =>
                    confirmAssignment(button.dataset.assignmentId, button);
            });
        }

        renderActiveDeliveries(assignments);

    } catch (error) {
        count.textContent = "!";
        container.innerHTML =
            `<div class="error">${escapeHtml(error.message)}</div>`;
    }
}

function renderAssignment(item) {
    return `
        <div class="assignment">
            <div class="assignment-main">
                <div class="awb">
                    ${escapeHtml(item.awb || item.shipment_id)}
                </div>

                <div class="details">
                    <span>📦 ${escapeHtml(item.shipment_id)}</span>
                    <span>👤 ${escapeHtml(item.customer_name || "-")}</span>
                    <span>📍 ${escapeHtml(item.delivery_address || "-")}</span>
                    <span>🏢 ${escapeHtml(item.current_hub || item.hub_code || "-")}</span>
                </div>
            </div>

            <button
                class="confirm-btn"
                data-assignment-id="${escapeHtml(item.assignment_id)}">
                CONFIRM
            </button>
        </div>
    `;
}

function renderActiveDeliveries(items) {
    const container = document.getElementById("activeDeliveries");

    const active = items.filter(item =>
        ["PICKED_UP", "OUT_FOR_DELIVERY"].includes(
            String(item.status).toUpperCase()
        )
    );

    if (!active.length) {
        container.innerHTML =
            '<div class="empty">No active deliveries right now.</div>';
        return;
    }

    container.innerHTML = active.map(item => `
        <div class="delivery-card">

            <div class="delivery-header">
                <div>
                    <span class="awb">
                        ${escapeHtml(item.awb || item.shipment_id)}
                    </span>

                    <small>
                        ${escapeHtml(item.shipment_id)}
                    </small>
                </div>

                <span class="delivery-status">
                    ${escapeHtml(item.status)}
                </span>
            </div>

            <div class="customer">
                <strong>${escapeHtml(item.customer_name || "Customer")}</strong>
                <span>${escapeHtml(item.customer_phone || "")}</span>
                <p>${escapeHtml(item.delivery_address || "-")}</p>
            </div>

            <div class="delivery-info">
                <div>
                    <span>COD</span>
                    <b>${money(item.amount)}</b>
                </div>

                <div>
                    <span>Hub</span>
                    <b>${escapeHtml(item.current_hub || item.hub_code || "-")}</b>
                </div>
            </div>

            <div class="action-row">
                <button
                    class="cod-btn"
                    onclick="collectCOD('${escapeHtml(item.assignment_id)}', this)">
                    COLLECT COD
                </button>

                <button
                    class="deliver-btn"
                    onclick="deliverShipment('${escapeHtml(item.assignment_id)}', this)">
                    DELIVER
                </button>

                <button
                    class="rto-btn"
                    onclick="rtoShipment('${escapeHtml(item.assignment_id)}', this)">
                    RTO
                </button>
            </div>

        </div>
    `).join("");
}

async function confirmAssignment(assignmentId, button) {
    button.disabled = true;
    button.textContent = "CONFIRMING...";

    try {
        const response = await fetch(
            `/api/assignments/${encodeURIComponent(assignmentId)}/confirm`,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    partner_id: partnerId
                })
            }
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.message || "Confirmation failed");
        }

        await loadAll();

    } catch (error) {
        alert(error.message);
        button.disabled = false;
        button.textContent = "CONFIRM";
    }
}

async function collectCOD(assignmentId, button) {
    if (!confirm("Confirm COD collection?")) return;

    button.disabled = true;
    button.textContent = "COLLECTING...";

    try {
        const response = await fetch(
            `/api/assignments/${encodeURIComponent(assignmentId)}/collect-cod`,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    partner_id: partnerId,
                    note: "COD collected by delivery partner"
                })
            }
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.message || "COD collection failed");
        }

        await loadAll();

    } catch (error) {
        alert(error.message);
        button.disabled = false;
        button.textContent = "COLLECT COD";
    }
}

async function deliverShipment(assignmentId, button) {
    if (!confirm("Mark this shipment as delivered?")) return;

    button.disabled = true;
    button.textContent = "DELIVERING...";

    try {
        const response = await fetch(
            `/api/assignments/${encodeURIComponent(assignmentId)}/deliver`,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    partner_id: partnerId,
                    hub_code: "HUB001",
                    note: "Shipment delivered successfully"
                })
            }
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.message || "Delivery failed");
        }

        await loadAll();

    } catch (error) {
        alert(error.message);
        button.disabled = false;
        button.textContent = "DELIVER";
    }
}

async function rtoShipment(assignmentId, button) {
    const reason = prompt(
        "Enter RTO reason:",
        "Customer unavailable"
    );

    if (!reason) return;

    button.disabled = true;
    button.textContent = "PROCESSING...";

    try {
        const response = await fetch(
            `/api/assignments/${encodeURIComponent(assignmentId)}/rto`,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    partner_id: partnerId,
                    hub_code: "HUB001",
                    reason: reason
                })
            }
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(data.message || "RTO failed");
        }

        await loadAll();

    } catch (error) {
        alert(error.message);
        button.disabled = false;
        button.textContent = "RTO";
    }
}


function showPage(pageId, button){

    document.querySelectorAll(".page").forEach(page=>{
        page.classList.remove("active");
    });

    const page=document.getElementById(pageId);

    if(page){
        page.classList.add("active");
    }

    document.querySelectorAll(".nav-btn").forEach(btn=>{
        btn.classList.remove("active");
    });

    if(button){
        button.classList.add("active");
    }

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });
}

function updateProfessionalProfile(partner){

    if(!partner) return;

    const name=partner.name || "Partner";

    setText("appWelcome","Welcome, "+name+" 👋");
    setText("profileName",name);
    setText("profileId",partner.partner_id || "-");
    setText("profilePhone",partner.phone || "-");
    setText("profileCity",partner.city || "-");
    setText("profileVehicle",partner.vehicle_type || "-");

    const avatar=document.getElementById("profileAvatar");

    if(avatar){
        avatar.textContent=name.charAt(0).toUpperCase();
    }
}

function updateEarningsPage(earnings){

    if(!earnings) return;

    setText(
        "earningsPageTotal",
        money(earnings.total_amount)
    );

    renderEarningsPage(earnings.recent || []);
}

function renderEarningsPage(items){

    const box=document.getElementById("earningsPageList");

    if(!box) return;

    if(!items.length){
        box.innerHTML='<div class="empty">No earnings available.</div>';
        return;
    }

    box.innerHTML=items.map(item=>`
        <div class="item">
            <div class="item-top">
                <div class="item-id">
                    ${escapeHtml(item.shipment_id || "-")}
                </div>

                <span class="badge">
                    ${escapeHtml(item.status || "-")}
                </span>
            </div>

            <div class="item-meta">
                <span>${escapeHtml(item.earning_type || "Delivery earning")}</span>
                <strong>${money(item.amount)}</strong>
            </div>
        </div>
    `).join("");
}


function renderDeliveryHistory(items) {
    const box = document.getElementById("deliveryHistory");

    if (!box) return;

    const history = (items || []).filter(item => {
        const status = String(
            item.status || item.shipment_status || ""
        ).toUpperCase();

        return [
            "COMPLETED",
            "DELIVERED",
            "RTO"
        ].includes(status);
    });

    if (!history.length) {
        box.innerHTML =
            '<div class="empty">No delivery history available.</div>';
        return;
    }

    box.innerHTML = history.map(item => {
        const status = String(
            item.status || item.shipment_status || "-"
        ).toUpperCase();

        const isRto = status === "RTO";

        return `
            <div class="item history-item">

                <div class="item-top">

                    <div>
                        <div class="item-id">
                            ${escapeHtml(
                                item.awb ||
                                item.shipment_id ||
                                "-"
                            )}
                        </div>

                        <div class="history-shipment">
                            ${escapeHtml(
                                item.shipment_id || "-"
                            )}
                        </div>
                    </div>

                    <span class="badge ${isRto ? "rto-badge" : "delivered-badge"}">
                        ${escapeHtml(status)}
                    </span>

                </div>

                <div class="item-meta">

                    <span>
                        👤 ${escapeHtml(
                            item.customer_name || "Customer"
                        )}
                    </span>

                    <span>
                        📍 ${escapeHtml(
                            item.delivery_address || "-"
                        )}
                    </span>

                    <span>
                        🏢 ${escapeHtml(
                            item.hub_code ||
                            item.destination_hub ||
                            "-"
                        )}
                    </span>

                </div>

                <div class="history-footer">

                    <strong>
                        ₹${Number(
                            item.amount || 0
                        ).toLocaleString("en-IN", {
                            maximumFractionDigits: 2
                        })}
                    </strong>

                    <span>
                        ${escapeHtml(
                            item.completed_at ||
                            item.assigned_at ||
                            "-"
                        )}
                    </span>

                </div>

            </div>
        `;
    }).join("");
}

async function loadDeliveryHistory() {
    const box = document.getElementById("deliveryHistory");

    if (!box) return;

    box.innerHTML =
        '<div class="empty">Loading delivery history...</div>';

    try {
        const response = await fetch(
            `/api/partners/${encodeURIComponent(partnerId)}/assignments`
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
            throw new Error(
                data.message || "History request failed"
            );
        }

        renderDeliveryHistory(
            data.assignments || []
        );

    } catch (error) {
        box.innerHTML =
            `<div class="error">${escapeHtml(error.message)}</div>`;
    }
}

async function loadAll() {
    try {
        await loadDashboard();
        await loadPendingAssignments();
        await loadDeliveryHistory();
    } catch (error) {
        console.error(error);
    }
}

loadAll();
setInterval(loadAll, 30000);
</script>

</body>
</html>
