<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#111827">
<title>Delyvo Market</title>

<style>
*{box-sizing:border-box}
body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f5f6f8;
    color:#111827;
}
header{
    position:sticky;
    top:0;
    z-index:10;
    background:#111827;
    color:white;
    padding:14px;
}
.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}
.logo{
    font-size:23px;
    font-weight:800;
}
.cart{
    background:white;
    color:#111827;
    border:0;
    border-radius:20px;
    padding:8px 13px;
    font-weight:bold;
}
.search{
    margin-top:12px;
    width:100%;
    padding:13px;
    border:0;
    border-radius:10px;
    font-size:15px;
}
.container{
    padding:15px;
    max-width:900px;
    margin:auto;
}
.banner{
    background:linear-gradient(135deg,#111827,#374151);
    color:white;
    border-radius:16px;
    padding:22px;
    margin-bottom:18px;
}
.banner h1{margin:0 0 7px}
.banner p{margin:0;color:#d1d5db}

.section-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:18px 0 10px;
}

.sellers{
    display:flex;
    gap:10px;
    overflow-x:auto;
    padding-bottom:5px;
}
.seller{
    min-width:145px;
    padding:12px;
    border:0;
    border-radius:12px;
    background:white;
    box-shadow:0 2px 8px #00000010;
    text-align:left;
}
.seller.active{
    outline:2px solid #111827;
}
.seller-name{
    font-weight:bold;
}
.seller-city{
    font-size:12px;
    color:#6b7280;
    margin-top:4px;
}
.seller-products{
    font-size:11px;
    color:#6b7280;
    margin-top:4px;
}

.categories{
    display:flex;
    gap:10px;
    overflow-x:auto;
}
.category{
    min-width:85px;
    padding:12px 10px;
    border:0;
    border-radius:12px;
    background:white;
    box-shadow:0 2px 8px #00000010;
}
.category.active{
    background:#111827;
    color:white;
}

.products{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}
.card{
    background:white;
    border-radius:14px;
    overflow:hidden;
    box-shadow:0 2px 10px #00000010;
}
.pic{
    height:145px;
    background:#e5e7eb;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:45px;
}
.info{padding:11px}
.name{
    font-weight:bold;
    min-height:38px;
}
.seller-label{
    font-size:12px;
    color:#6b7280;
    margin-top:4px;
}
.price{
    font-size:19px;
    font-weight:800;
    margin:7px 0;
}
.stock{
    font-size:12px;
    color:#6b7280;
}
.add{
    width:100%;
    border:0;
    border-radius:9px;
    padding:10px;
    margin-top:8px;
    background:#111827;
    color:white;
    font-weight:bold;
}
.detail{
    width:100%;
    border:1px solid #ddd;
    border-radius:9px;
    padding:9px;
    margin-top:7px;
    background:white;
    font-weight:bold;
}

.empty{
    background:white;
    padding:25px;
    border-radius:14px;
    text-align:center;
    grid-column:1/-1;
}

.modal{
    display:none;
    position:fixed;
    inset:0;
    background:#0008;
    z-index:20;
    align-items:flex-end;
}
.sheet{
    background:white;
    width:100%;
    max-height:90vh;
    overflow:auto;
    border-radius:20px 20px 0 0;
    padding:18px;
}
.close{
    float:right;
    border:0;
    background:#eee;
    border-radius:50%;
    width:35px;
    height:35px;
}
.item{
    display:flex;
    justify-content:space-between;
    gap:12px;
    padding:12px 0;
    border-bottom:1px solid #eee;
}
.qty button{
    border:1px solid #ddd;
    background:white;
    padding:4px 9px;
}
input,textarea,select{
    width:100%;
    padding:12px;
    margin:6px 0;
    border:1px solid #ddd;
    border-radius:9px;
}
.primary{
    width:100%;
    padding:13px;
    background:#111827;
    color:white;
    border:0;
    border-radius:10px;
    font-weight:bold;
    margin-top:10px;
}
.order-card{
    background:#f9fafb;
    border:1px solid #eee;
    border-radius:12px;
    padding:13px;
    margin:10px 0;
}
.track{
    margin-top:10px;
    padding:10px;
    border-radius:9px;
    background:#eef2ff;
}
.nav{
    position:fixed;
    bottom:0;
    left:0;
    right:0;
    background:white;
    border-top:1px solid #ddd;
    display:flex;
    justify-content:space-around;
    padding:10px;
    z-index:15;
}
.nav button{
    border:0;
    background:none;
    font-size:12px;
}
main{padding-bottom:70px}

@media(min-width:700px){
    .products{
        grid-template-columns:repeat(4,1fr);
    }
}
</style>
</head>

<body>

<header>
    <div class="top">
        <div class="logo">Delyvo Market</div>
        <button class="cart" onclick="openCart()">
            🛒 Cart <span id="cartCount">0</span>
        </button>
    </div>

    <input
        id="search"
        class="search"
        placeholder="Search products, sellers..."
        oninput="filterProducts()"
    >
</header>

<main>
<div class="container">

    <div class="banner">
        <h1>Shop on Delyvo</h1>
        <p>Products from Delyvo sellers, delivered to your door.</p>
    </div>

    <div class="section-title">
        <h3>🛍️ Sellers</h3>
        <span id="sellerCount"></span>
    </div>

    <div id="sellers" class="sellers">
        <div class="empty">Loading sellers...</div>
    </div>

    <div class="section-title">
        <h3>Categories</h3>
    </div>

    <div class="categories">
        <button class="category active" onclick="setCategory('all',this)">
            🛍️ All
        </button>
        <button class="category" onclick="setCategory('fashion',this)">
            👕 Fashion
        </button>
        <button class="category" onclick="setCategory('electronics',this)">
            📱 Electronics
        </button>
        <button class="category" onclick="setCategory('home',this)">
            🏠 Home
        </button>
        <button class="category" onclick="setCategory('beauty',this)">
            💄 Beauty
        </button>
    </div>

    <div class="section-title">
        <h3>Products</h3>
        <span id="productCount"></span>
    </div>

    <div id="products" class="products">
        <div class="empty">Loading products...</div>
    </div>

</div>
</main>

<div class="nav">
    <button onclick="window.scrollTo({top:0,behavior:'smooth'})">
        🏠<br>Home
    </button>
    <button onclick="openCart()">
        🛒<br>Cart
    </button>
    <button onclick="openOrders()">
        📦<br>Orders
    </button>
    <button onclick="openProfile()">
        👤<br>Account
    </button>
</div>

<!-- PRODUCT DETAIL -->
<div id="productModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('productModal')">×</button>
<div id="productDetail"></div>
</div>
</div>

<!-- CART -->
<div id="cartModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('cartModal')">×</button>
<h2>Your Cart</h2>
<div id="cartItems"></div>
<div id="cartTotal"></div>
<button class="primary" onclick="openCheckout()">
    Proceed to Checkout
</button>
</div>
</div>

<!-- CHECKOUT -->
<div id="checkoutModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('checkoutModal')">×</button>
<h2>Checkout</h2>

<input id="customerName" placeholder="Your name">
<input id="customerPhone" placeholder="Phone number">
<textarea id="address" placeholder="Delivery address"></textarea>

<select id="paymentType">
    <option value="COD">Cash on Delivery</option>
    <option value="PREPAID">Online Payment</option>
</select>

<div id="checkoutTotal"></div>

<button class="primary" onclick="placeOrder()">
    Place Order
</button>
</div>
</div>

<!-- ORDERS -->
<div id="ordersModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('ordersModal')">×</button>
<h2>My Orders</h2>

<input
    id="orderLookup"
    placeholder="Enter Order ID"
>

<button class="primary" onclick="lookupOrder()">
    Track Order
</button>

<div id="orders"></div>
</div>
</div>

<!-- PROFILE -->
<div id="profileModal" class="modal">
<div class="sheet">
<button class="close" onclick="closeModal('profileModal')">×</button>
<h2>My Account</h2>
<p>👤 Delyvo Market Customer</p>
<p>Your orders and shipment tracking are available from the Orders section.</p>
</div>
</div>

<script>

let products = [];
let sellers = [];
let cart = [];
let category = "all";
let selectedSeller = "";

let customerOrders = JSON.parse(
    localStorage.getItem("delyvo_customer_orders") || "[]"
);

function saveCustomerOrders(){
    localStorage.setItem(
        "delyvo_customer_orders",
        JSON.stringify(customerOrders.slice(0, 20))
    );
}

function rememberOrder(orderId){
    if(!orderId) return;

    customerOrders = [
        orderId,
        ...customerOrders.filter(x => x !== orderId)
    ].slice(0, 20);

    saveCustomerOrders();
}


function paymentStatusLabel(status){

    const value = String(status || "").toUpperCase();

    if(value === "PAID"){
        return "PAID";
    }

    if(value === "PENDING"){
        return "PENDING";
    }

    if(value === "FAILED"){
        return "FAILED";
    }

    if(value === "COLLECTED"){
        return "COLLECTED";
    }

    return value || "—";
}

function money(x){
    return "₹" + Number(x || 0).toFixed(0);
}

function escapeHtml(s){
    return String(s || "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
}

/* =========================
   LOAD SELLERS
========================= */

async function loadSellers(){

    const box = document.getElementById("sellers");

    try{

        const r = await fetch("/api/market/sellers");
        const data = await r.json();

        if(!r.ok || data.success === false){
            throw new Error("Seller API failed");
        }

        sellers = data.sellers || [];

        document.getElementById("sellerCount").textContent =
            `${sellers.length} sellers`;

        renderSellers();

    }catch(e){

        box.innerHTML =
            `<div class="empty">
                Sellers load nahi ho paaye.
             </div>`;
    }
}

function renderSellers(){

    const box = document.getElementById("sellers");

    let html = `
        <button
            class="seller ${selectedSeller === "" ? "active" : ""}"
            onclick="selectSeller('')"
        >
            <div class="seller-name">🛍️ All Sellers</div>
            <div class="seller-city">Delyvo Marketplace</div>
        </button>
    `;

    html += sellers.map(s => `
        <button
            class="seller ${selectedSeller === s.seller_id ? "active" : ""}"
            onclick="selectSeller('${escapeHtml(s.seller_id)}')"
        >
            <div class="seller-name">
                ${escapeHtml(s.name)}
            </div>
            <div class="seller-city">
                📍 ${escapeHtml(s.city || "India")}
            </div>
            <div class="seller-products">
                ${Number(s.product_count || 0)} products
            </div>
        </button>
    `).join("");

    box.innerHTML = html;
}

function selectSeller(id){

    selectedSeller = id;

    renderSellers();

    loadProducts();
}

/* =========================
   LOAD PRODUCTS
========================= */

async function loadProducts(){

    const box = document.getElementById("products");

    box.innerHTML =
        `<div class="empty">Loading products...</div>`;

    try{

        let url = "/api/market/products";

        if(selectedSeller){
            url += "?seller_id=" +
                encodeURIComponent(selectedSeller);
        }

        const r = await fetch(url);
        const data = await r.json();

        if(!r.ok || data.success === false){
            throw new Error("Product API failed");
        }

        products = data.products || [];

        filterProducts();

    }catch(e){

        box.innerHTML =
            `<div class="empty">
                Products load nahi ho paaye.
             </div>`;
    }
}

function renderProducts(list){

    const box = document.getElementById("products");

    document.getElementById("productCount").textContent =
        `${list.length} products`;

    if(!list.length){

        box.innerHTML =
            `<div class="empty">
                No products found.
             </div>`;

        return;
    }

    box.innerHTML = list.map(p => `

        <div class="card">

            <div class="pic">📦</div>

            <div class="info">

                <div class="name">
                    ${escapeHtml(p.name)}
                </div>

                <div class="seller-label">
                    🏪 ${escapeHtml(p.seller_name || "Delyvo Seller")}
                </div>

                <div class="seller-label">
                    📍 ${escapeHtml(p.seller_city || "")}
                </div>

                <div class="price">
                    ${money(p.price)}
                </div>

                <div class="stock">
                    ${Number(p.stock)} available
                </div>

                <button
                    class="add"
                    onclick="addToCart('${escapeHtml(p.product_id)}')"
                >
                    Add to Cart
                </button>

                <button
                    class="detail"
                    onclick="openProduct('${escapeHtml(p.product_id)}')"
                >
                    View Product
                </button>

            </div>
        </div>

    `).join("");
}

/* =========================
   SEARCH / CATEGORY
========================= */

function setCategory(c,button){

    category = c;

    document
        .querySelectorAll(".category")
        .forEach(x => x.classList.remove("active"));

    if(button){
        button.classList.add("active");
    }

    filterProducts();
}

function filterProducts(){

    const q = String(
        document.getElementById("search").value || ""
    ).trim().toLowerCase();

    let list = products.slice();

    if(selectedSeller){
        list = list.filter(
            p => String(p.seller_id || "") === selectedSeller
        );
    }

    if(category !== "all"){

        list = list.filter(p => {

            const text = [
                p.name,
                p.description,
                p.sku
            ]
            .join(" ")
            .toLowerCase();

            return text.includes(category.toLowerCase());
        });
    }

    if(q){

        list = list.filter(p => {

            const text = [
                p.name,
                p.description,
                p.sku,
                p.seller_name,
                p.seller_city
            ]
            .join(" ")
            .toLowerCase();

            return text.includes(q);
        });
    }

    renderProducts(list);
}

/* =========================
   PRODUCT DETAIL
========================= */

async function openProduct(productId){

    const box =
        document.getElementById("productDetail");

    document.getElementById("productModal")
        .style.display = "flex";

    box.innerHTML = "Loading product...";

    try{

        const r =
            await fetch(
                "/api/market/product/" +
                encodeURIComponent(productId)
            );

        const data = await r.json();

        if(!r.ok || data.success === false){
            throw new Error("Product not found");
        }

        const p = data.product;

        box.innerHTML = `

            <div class="pic">📦</div>

            <h2>
                ${escapeHtml(p.name)}
            </h2>

            <p>
                🏪 ${escapeHtml(p.seller_name || "")}
            </p>

            <p>
                📍 ${escapeHtml(p.seller_city || "")}
            </p>

            <h2>${money(p.price)}</h2>

            <p>
                ${escapeHtml(p.description || "No description available.")}
            </p>

            <p>
                Stock: ${Number(p.stock)}
            </p>

            <button
                class="primary"
                onclick="addToCart('${escapeHtml(p.product_id)}');closeModal('productModal')"
            >
                Add to Cart
            </button>
        `;

    }catch(e){

        box.innerHTML =
            `<div class="empty">
                Product details load nahi ho paaye.
             </div>`;
    }
}

/* =========================
   CART
========================= */

function addToCart(id){

    const product = products.find(
        p => String(p.product_id) === String(id)
    );

    if(!product){
        alert("Product not found.");
        return;
    }

    const stock = Number(product.stock || 0);

    if(stock <= 0){
        alert("This product is currently out of stock.");
        return;
    }

    const existing = cart.find(
        x => String(x.product_id) === String(id)
    );

    if(existing){

        if(Number(existing.quantity || 0) >= stock){
            alert("Maximum available stock reached.");
            return;
        }

        existing.quantity =
            Number(existing.quantity || 0) + 1;

    }else{

        cart.push({
            product_id: product.product_id,
            product_name: product.name,
            seller_id: product.seller_id,
            seller_name: product.seller_name,
            unit_price: Number(product.price || 0),
            quantity: 1,
            stock: stock
        });
    }

    saveCart();
    updateCartCount();
    renderCart();
}

function saveCart(){
    localStorage.setItem(
        "delyvo_cart",
        JSON.stringify(cart)
    );
}

function loadCart(){

    try{
        cart = JSON.parse(
            localStorage.getItem("delyvo_cart") || "[]"
        );
    }catch{
        cart = [];
    }

    updateCartCount();
}

function updateCartProductsStock(){

    cart = cart.map(item => {

        const p = products.find(
            x => String(x.product_id) === String(item.product_id)
        );

        if(p){
            item.product_name = p.name;
            item.seller_id = p.seller_id;
            item.seller_name = p.seller_name;
            item.unit_price = Number(p.price || 0);
            item.stock = Number(p.stock || 0);
        }

        return item;
    });

    saveCart();
}

function updateCartCount(){

    document.getElementById("cartCount")
        .textContent =
        cart.reduce(
            (a,b) => a + Number(b.quantity || 0),
            0
        );
}

function openCart(){

    renderCart();

    document.getElementById("cartModal")
        .style.display = "flex";
}

function renderCart(){

    const box =
        document.getElementById("cartItems");

    if(!cart.length){

        box.innerHTML =
            `<div class="empty">
                Cart is empty.
             </div>`;

        document.getElementById("cartTotal")
            .innerHTML = "";

        return;
    }

    box.innerHTML = cart.map((x,i) => `

        <div class="item">

            <div>
                <b>${escapeHtml(x.name)}</b><br>
                🏪 ${escapeHtml(x.seller_name || "")}<br>
                ${money(x.price)} × ${x.quantity}
            </div>

            <div class="qty">

                <button onclick="changeQty(${i},-1)">
                    −
                </button>

                ${x.quantity}

                <button onclick="changeQty(${i},1)">
                    +
                </button>

            </div>

        </div>

    `).join("");

    const subtotal =
        cart.reduce(
            (a,b) =>
                a +
                Number(b.price) *
                Number(b.quantity),
            0
        );

    document.getElementById("cartTotal")
        .innerHTML =
        `<h3>Subtotal: ${money(subtotal)}</h3>`;
}

function changeQty(i,d){

    if(!cart[i]){
        return;
    }

    const next =
        Number(cart[i].quantity || 0) + Number(d || 0);

    if(next <= 0){

        cart.splice(i,1);

    }else{

        const maxStock =
            Number(cart[i].stock || 999999);

        if(next > maxStock){
            alert("Maximum available stock reached.");
            return;
        }

        cart[i].quantity = next;
    }

    saveCart();
    updateCartCount();
    renderCart();
}

/* =========================
   CHECKOUT
========================= */

function calculateCartTotal(){

    return cart.reduce(
        (sum,item) =>
            sum +
            Number(item.unit_price || 0) *
            Number(item.quantity || 0),
        0
    );
}

function openCheckout(){

    if(!cart.length){

        alert("Cart is empty");
        return;
    }

    closeModal("cartModal");

    const subtotal =
        cart.reduce(
            (a,b) =>
                a +
                Number(b.price) *
                Number(b.quantity),
            0
        );

    const deliveryFee = 50;

    document.getElementById("checkoutTotal")
        .innerHTML = `
            <h3>
                Total: ${money(subtotal + deliveryFee)}
            </h3>
            <small>
                Delivery fee: ${money(deliveryFee)}
            </small>
        `;

    document.getElementById("checkoutModal")
        .style.display = "flex";
}

async function placeOrder(){

    if(!cart.length){
        alert("Cart is empty.");
        return;
    }

    const customerName =
        document.getElementById("customerName").value.trim();

    const customerPhone =
        document.getElementById("customerPhone").value.trim();

    const address =
        document.getElementById("address").value.trim();

    const paymentType =
        document.getElementById("paymentType").value;

    if(!customerName){
        alert("Please enter your name.");
        return;
    }

    if(!/^[0-9]{10}$/.test(customerPhone)){
        alert("Please enter a valid 10-digit phone number.");
        return;
    }

    if(!address){
        alert("Please enter delivery address.");
        return;
    }

    if(!["COD","PREPAID"].includes(paymentType)){
        alert("Please select a valid payment method.");
        return;
    }



    if(!cart.length){

        alert("Cart is empty");
        return;
    }

    const customer_name =
        document
            .getElementById("customerName")
            .value
            .trim();

    const customer_phone =
        document
            .getElementById("customerPhone")
            .value
            .trim();

    const delivery_address =
        document
            .getElementById("address")
            .value
            .trim();

    const payment_type =
        document
            .getElementById("paymentType")
            .value;

    if(
        !customer_name ||
        !customer_phone ||
        !delivery_address
    ){

        alert("Please fill all delivery details");
        return;
    }

    /*
      Current backend seller-order API
      accepts one seller per order.
      Therefore mixed-seller cart is split
      into separate orders.
    */

    const groups = {};

    cart.forEach(x => {

        if(!groups[x.seller_id]){
            groups[x.seller_id] = [];
        }

        groups[x.seller_id].push({
            product_id:x.product_id,
            quantity:x.quantity
        });

    });

    const createdOrders = [];

    try{

        for(const sellerId of Object.keys(groups)){

            const r =
                await fetch(
                    "/api/sellers/" +
                    encodeURIComponent(sellerId) +
                    "/orders",
                    {
                        method:"POST",
                        headers:{
                            "Content-Type":
                                "application/json"
                        },
                        body:JSON.stringify({
                            customer_name,
                            customer_phone,
                            delivery_address,
                            payment_type,
                            delivery_fee:50,
                            items:groups[sellerId]
                        })
                    }
                );

            const data = await r.json();

            if(!r.ok || data.success === false){

                throw new Error(
                    data.message ||
                    "Order failed"
                );
            }

            const order =
                data.order || {};

            createdOrders.push(
                data.order_id ||
                order.order_id ||
                "ORDER"
            );
        }

        cart = [];
        saveCart();
        updateCartCount();

        closeModal("checkoutModal");

        createdOrders.forEach(
            id => rememberOrder(id)
        );

        alert(
            "Order placed successfully!\n\n" +
            "Order IDs:\n" +
            createdOrders.join("\n")
        );

        closeModal("checkoutModal");
        closeModal("cartModal");

        loadProducts();

    }catch(e){

        alert(
            e.message ||
            "Server connection error"
        );
    }
}

/* =========================
   ORDERS
========================= */

async function openOrders(){

    document.getElementById("ordersModal").style.display = "flex";

    renderSavedOrders();

    await syncCustomerOrders();

    renderSavedOrders();
}


async function syncCustomerOrders(){

    if(!customerOrders.length){
        return;
    }

    try{

        const r = await fetch("/api/market/customer/orders", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                order_ids: customerOrders
            })
        });

        const data = await r.json();

        if(!r.ok || data.success === false){
            return;
        }

        const serverIds = (data.orders || [])
            .map(x => x.order_id)
            .filter(Boolean);

        customerOrders = [
            ...serverIds,
            ...customerOrders.filter(x => !serverIds.includes(x))
        ].slice(0, 20);

        saveCustomerOrders();

    }catch(e){
        console.log("Customer order sync unavailable");
    }
}

function renderSavedOrders(){

    const box = document.getElementById("orders");

    if(!customerOrders.length){

        box.innerHTML = `
            <div class="empty">
                No saved orders yet.<br>
                Place an order and it will appear here.
            </div>
        `;

        return;
    }

    box.innerHTML = `
        <h3>Recent Orders</h3>

        ${customerOrders.map(id => `
            <div class="order-card">

                <div>
                    <b>${escapeHtml(id)}</b>
                </div>

                <button
                    class="detail"
                    onclick="loadOrderById('${escapeHtml(id)}')">
                    View / Track
                </button>

            </div>
        `).join("")}
    `;
}

async function loadOrderById(orderId){
    document.getElementById("orderLookup").value = orderId;
    await lookupOrder();
}


async function cancelMarketOrder(orderId){

    if(!orderId){
        return;
    }

    if(!confirm("Cancel this order?")){
        return;
    }

    try{

        const r = await fetch(
            "/api/market/orders/" +
            encodeURIComponent(orderId) +
            "/cancel",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                }
            }
        );

        const data = await r.json();

        if(!r.ok || data.success === false){
            throw new Error(
                data.message || "Order cancellation failed"
            );
        }

        alert("Order cancelled successfully.");

        await lookupOrder();

    }catch(e){

        alert(
            e.message ||
            "Unable to cancel order."
        );
    }
}


async function requestMarketReturn(orderId){

    if(!orderId){
        return;
    }

    if(!confirm("Request return for this delivered order?")){
        return;
    }

    try{

        const r = await fetch(
            "/api/market/orders/" +
            encodeURIComponent(orderId) +
            "/return",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                }
            }
        );

        const data = await r.json();

        if(!r.ok || data.success === false){
            throw new Error(
                data.message || "Return request failed"
            );
        }

        alert("Return request created successfully.");

        await lookupOrder();

    }catch(e){

        alert(
            e.message ||
            "Unable to create return request."
        );
    }
}


async function lookupOrder(){

    const orderId =
        document
            .getElementById("orderLookup")
            .value
            .trim();

    if(!orderId){

        alert("Enter Order ID");
        return;
    }

    const box =
        document.getElementById("orders");

    box.innerHTML = "Loading order...";

    try{

        const r =
            await fetch(
                "/api/market/orders/" +
                encodeURIComponent(orderId)
            );

        const data = await r.json();

        if(!r.ok || data.success === false){

            throw new Error(
                data.message ||
                "Order not found"
            );
        }

        const o = data.order;
        const items = data.items || [];
        const shipment = data.shipment;
        const events = data.events || [];

        rememberOrder(o.order_id);

        let eventsHtml = "";

        if(events.length){

            eventsHtml = events.map(e => `
                <div class="track">
                    <b>${escapeHtml(e.status)}</b><br>
                    ${escapeHtml(e.note || "")}<br>
                    <small>
                        ${escapeHtml(e.created_at || "")}
                    </small>
                </div>
            `).join("");

        }else{

            eventsHtml =
                `<div class="track">
                    Shipment tracking events not available yet.
                 </div>`;
        }

        box.innerHTML = `

            <div class="order-card">

                <h3>
                    Order ${escapeHtml(o.order_id)}
                </h3>

                <p>
                    Status:
                    <b>${escapeHtml(o.order_status)}</b>
                </p>

                <div style="margin-top:10px;">

                    ${
                        ["PLACED","NEW"].includes(
                            String(o.order_status || "").toUpperCase()
                        )
                        ?
                        `
                        <button
                            class="detail"
                            onclick="cancelMarketOrder('${escapeHtml(o.order_id)}')">
                            Cancel Order
                        </button>
                        `
                        :
                        ""
                    }

                    ${
                        String(o.order_status || "").toUpperCase() === "DELIVERED"
                        ?
                        `
                        <button
                            class="detail"
                            onclick="requestMarketReturn('${escapeHtml(o.order_id)}')">
                            Request Return
                        </button>
                        `
                        :
                        ""
                    }

                </div>

                <p>
                    Payment:
                    <b>${escapeHtml(o.payment_type || "—")}</b>
                    -
                    <b>${escapeHtml(o.payment_status || "—")}</b>
                </p>

                <p>
                    Total:
                    <b>${money(o.total_amount)}</b>
                </p>

                <hr>

                <b>Items</b>

                ${items.map(i => `
                    <div class="item">
                        <div>
                            ${escapeHtml(i.product_name)}
                        </div>
                        <div>
                            × ${i.quantity}
                        </div>
                    </div>
                `).join("")}

                <h4>Shipment</h4>

                ${
                    shipment
                    ?
                    `
                    <p>
                        AWB:
                        <b>
                            ${escapeHtml(shipment.awb || "")}
                        </b>
                    </p>

                    <p>
                        Shipment status:
                        <b>
                            ${escapeHtml(shipment.status || "")}
                        </b>
                    </p>

                    ${eventsHtml}
                    `
                    :
                    `
                    <div class="track">
                        Shipment not created yet.
                    </div>
                    `
                }

            </div>
        `;

    }catch(e){

        box.innerHTML =
            `<div class="empty">
                ${escapeHtml(
                    e.message ||
                    "Order load failed."
                )}
             </div>`;
    }
}

