<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1.0">

<title>Delyvo Admin</title>

<style>

*{
    box-sizing:border-box;
}

body{
    margin:0;
    font-family:Arial,sans-serif;
    background:#f4f6f8;
    color:#111827;
}

header{
    background:#111827;
    color:white;
    padding:18px;
    position:sticky;
    top:0;
    z-index:10;
}

.logo{
    font-size:24px;
    font-weight:800;
}

.container{
    max-width:1000px;
    margin:auto;
    padding:16px;
}

.hero{
    background:#1f2937;
    color:white;
    padding:22px;
    border-radius:18px;
    margin-bottom:18px;
}

.hero h1{
    margin:0 0 8px;
}

.hero p{
    margin:0;
    color:#d1d5db;
}

.grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.card{
    background:white;
    border-radius:15px;
    padding:17px;
    box-shadow:0 2px 10px #00000012;
    margin-bottom:15px;
}

.stat{
    background:white;
    border-radius:15px;
    padding:17px;
    box-shadow:0 2px 10px #00000012;
}

.label{
    color:#6b7280;
    font-size:13px;
}

.number{
    font-size:28px;
    font-weight:800;
    margin-top:6px;
}

button{
    border:0;
    border-radius:9px;
    padding:11px 15px;
    background:#111827;
    color:white;
    font-weight:bold;
    cursor:pointer;
}

.result{
    margin-top:12px;
    background:#f3f4f6;
    border-radius:10px;
    padding:12px;
    overflow:auto;
    font-size:13px;
}

.table{
    width:100%;
    border-collapse:collapse;
}

.table th,
.table td{
    text-align:left;
    padding:10px;
    border-bottom:1px solid #eee;
}

.status{
    font-weight:bold;
}

@media(max-width:700px){

    .grid{
        grid-template-columns:repeat(2,1fr);
    }

    .table{
        font-size:12px;
    }

}

</style>
</head>

<body>

<header>
    <div class="logo">Delyvo Admin</div>
</header>

<div class="container">

<div class="hero">
    <h1>Delyvo Control Center</h1>
    <p>Manage companies, hubs, partners, shipments and platform operations.</p>
</div>

<div class="grid">

<div class="stat">
    <div class="label">Companies</div>
    <div id="companies" class="number">0</div>
</div>

<div class="stat">
    <div class="label">Sellers</div>
    <div id="sellers" class="number">0</div>
</div>

<div class="stat">
    <div class="label">Shipments</div>
    <div id="shipments" class="number">0</div>
</div>

<div class="stat">
    <div class="label">Partners</div>
    <div id="partners" class="number">0</div>
</div>

<div class="stat">
    <div class="label">Hubs</div>
    <div id="hubs" class="number">0</div>
</div>

<div class="stat">
    <div class="label">Products</div>
    <div id="products" class="number">0</div>
</div>

<div class="stat">
    <div class="label">Orders</div>
    <div id="orders" class="number">0</div>
</div>

<div class="stat">
    <div class="label">Payments</div>
    <div id="payments" class="number">0</div>
</div>

</div>

<div class="card">

<h3>Platform Status</h3>

<p class="status">
🟢 Delyvo Core Server Online
</p>

<button onclick="loadDashboard()">
Refresh Dashboard
</button>

<div id="result" class="result">
Loading...
</div>

</div>

<div class="card">

<h3>Recent Shipments</h3>

<button onclick="loadShipments()">
Refresh Shipments
</button>

<div id="shipmentBox" class="result">
Loading shipments...
</div>

</div>

<div class="card">

<h3>Companies</h3>

<button onclick="loadCompanies()">
Refresh Companies
</button>

<div id="companyBox" class="result">
Loading companies...
</div>

</div>

<div class="card">

<h3>Delivery Partners</h3>

<button onclick="loadPartners()">
Refresh Partners
</button>

<div id="partnerBox" class="result">
Loading partners...
</div>

</div>

</div>

<script>

function escapeHtml(value){

return String(value ?? "")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;");

}


async function loadDashboard(){

try{

const r=await fetch("/api/admin/dashboard");

const data=await r.json();

if(!r.ok || data.success===false){

throw new Error(data.message || "Dashboard failed");

}

const s=data.statistics || {};

document.getElementById("companies").textContent=s.companies || 0;
document.getElementById("sellers").textContent=s.sellers || 0;
document.getElementById("shipments").textContent=s.shipments || 0;
document.getElementById("partners").textContent=s.partners || 0;
document.getElementById("hubs").textContent=s.hubs || 0;
document.getElementById("products").textContent=s.products || 0;
document.getElementById("orders").textContent=s.orders || 0;
document.getElementById("payments").textContent=s.payments || 0;

document.getElementById("result").textContent=
"Dashboard loaded successfully.";

}catch(e){

document.getElementById("result").textContent=
"Dashboard error: "+e.message;

}

}


async function loadShipments(){

const box=document.getElementById("shipmentBox");

box.textContent="Loading...";

try{

const r=await fetch("/api/admin/shipments/recent");

const data=await r.json();

if(!data.shipments || !data.shipments.length){

box.textContent="No shipments found.";

return;

}

box.innerHTML=data.shipments.map(x=>`

<div style="padding:9px 0;border-bottom:1px solid #ddd">

<b>${escapeHtml(x.shipment_id || x.id)}</b><br>

Status:
${escapeHtml(x.status || "-")}

</div>

`).join("");

}catch(e){

box.textContent="Unable to load shipments.";

}

}


async function loadCompanies(){

const box=document.getElementById("companyBox");

box.textContent="Loading...";

try{

const r=await fetch("/api/admin/companies");

const data=await r.json();

if(!data.companies || !data.companies.length){

box.textContent="No companies found.";

return;

}

box.innerHTML=data.companies.map(x=>`

<div style="padding:9px 0;border-bottom:1px solid #ddd">

<b>${escapeHtml(x.name)}</b><br>

ID: ${escapeHtml(x.company_id)}<br>

Status: ${escapeHtml(x.status)}

</div>

`).join("");

}catch(e){

box.textContent="Unable to load companies.";

}

}


async function loadPartners(){

const box=document.getElementById("partnerBox");

box.textContent="Loading...";

try{

const r=await fetch("/api/admin/partners");

const data=await r.json();

if(!data.partners || !data.partners.length){

box.textContent="No delivery partners found.";

return;

}

box.innerHTML=data.partners.map(x=>`

<div style="padding:9px 0;border-bottom:1px solid #ddd">

<b>${escapeHtml(
x.name || x.partner_name || x.partner_id || x.id
)}</b><br>

Status:
${escapeHtml(x.status || "-")}

</div>

`).join("");

}catch(e){

box.textContent="Unable to load partners.";

}

}


loadDashboard();
loadShipments();
loadCompanies();
loadPartners();

</script>

</body>
</html>
