*{box-sizing:border-box}

:root{
    --bg:#f6f7fb;
    --card:#fff;
    --text:#171b2d;
    --muted:#7b8190;
    --border:#ececf2;
    --accent:#6c43d7;
}

body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:Arial,Helvetica,sans-serif;
}

.app{
    max-width:760px;
    margin:auto;
    padding-bottom:88px;
}

.topbar{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(12px);
    padding:15px 17px;
    border-bottom:1px solid var(--border);
}

.topbar-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.brand{
    font-size:22px;
    font-weight:900;
}

.top-action{
    width:38px;
    height:38px;
    border:0;
    border-radius:12px;
    background:#f1f1f5;
    font-size:18px;
}

.page{
    display:none;
    padding:12px 0;
}

.page.active{
    display:block;
}

.welcome{
    margin:10px 14px;
}

.welcome h1{
    margin:0;
    font-size:22px;
}

.welcome p{
    margin:5px 0 0;
    color:var(--muted);
    font-size:13px;
}

/* earnings */
.earnings{
    margin:14px;
    padding:22px;
    border-radius:22px;
    color:#fff;
    background:linear-gradient(135deg,#171b2d,#393158);
    box-shadow:0 8px 24px rgba(30,25,60,.16);
}

.earnings-label{
    font-size:11px;
    letter-spacing:1px;
    opacity:.7;
}

.earnings-value{
    font-size:35px;
    font-weight:900;
    margin:7px 0;
}

.earnings-sub{
    font-size:12px;
    opacity:.7;
}

.stats{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
    margin:14px;
}

.stat{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:16px;
    padding:16px;
}

.stat-label{
    color:var(--muted);
    font-size:11px;
}

.stat-value{
    margin-top:7px;
    font-size:24px;
    font-weight:900;
}

/* sections */
.section{
    margin:16px 14px;
}

.section-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:10px;
}

.section-head h2{
    margin:0;
    font-size:17px;
}

.section-head button{
    border:0;
    background:#eeeef4;
    border-radius:9px;
    padding:8px 11px;
    font-size:11px;
    font-weight:800;
}

/* cards */
.item{
    background:#fff;
    border:1px solid var(--border);
    border-radius:16px;
    padding:15px;
    margin-bottom:10px;
}

.item-top{
    display:flex;
    justify-content:space-between;
    gap:10px;
}

.item-id{
    font-size:14px;
    font-weight:900;
}

.badge{
    background:#f0ecff;
    color:var(--accent);
    border-radius:8px;
    padding:6px 8px;
    font-size:9px;
    font-weight:900;
}

.item-meta{
    margin-top:10px;
    display:flex;
    flex-direction:column;
    gap:5px;
    color:#687080;
    font-size:11px;
}

.item-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
    margin-top:13px;
}

.item-actions button{
    border:0;
    border-radius:10px;
    padding:11px;
    font-weight:800;
    font-size:10px;
}

.primary{
    background:var(--accent);
    color:white;
}

.dark{
    background:#171b2d;
    color:white;
}

.light{
    background:#f0f1f5;
    color:#343946;
}

.empty{
    background:#fff;
    border:1px dashed #dddde5;
    border-radius:14px;
    padding:22px 10px;
    text-align:center;
    color:#858b98;
    font-size:12px;
}

/* bottom nav */
.bottom-nav{
    position:fixed;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:min(760px,100%);
    height:70px;
    background:rgba(255,255,255,.97);
    backdrop-filter:blur(14px);
    border-top:1px solid var(--border);
    display:grid;
    grid-template-columns:repeat(4,1fr);
    z-index:100;
}

.nav-btn{
    border:0;
    background:transparent;
    color:#858b98;
    font-size:10px;
    font-weight:800;
}

.nav-btn span{
    display:block;
    font-size:21px;
    margin-bottom:3px;
}

.nav-btn.active{
    color:var(--accent);
}

/* profile */
.profile{
    margin:14px;
    background:#fff;
    border:1px solid var(--border);
    border-radius:20px;
    padding:20px;
}

.avatar{
    width:58px;
    height:58px;
    border-radius:18px;
    background:#eee9ff;
    color:var(--accent);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:23px;
    font-weight:900;
    margin-bottom:13px;
}

.profile h2{
    margin:0;
    font-size:20px;
}

.profile p{
    color:var(--muted);
    font-size:12px;
}

.info-row{
    display:flex;
    justify-content:space-between;
    padding:13px 0;
    border-bottom:1px solid #f0f0f3;
    font-size:12px;
}

.info-row:last-child{
    border-bottom:0;
}

.info-row span{
    color:var(--muted);
}

/* responsive */
@media(max-width:420px){
    .earnings-value{
        font-size:30px;
    }

    .stat{
        padding:14px;
    }

    .stat-value{
        font-size:21px;
    }
}
